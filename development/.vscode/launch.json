{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "Debug Goldfish",
            // Replace <path_to_your_binary> with the actual path to your
            // binary. If you want to debug BUILD target
            // `//path/to:my_test`, the path to your binary will be
            // `${workspaceFolder}/bazel-bin/path/to/my_test`.
            "program": "${workspaceFolder}/bazel-bin/hardware/generic/goldfish/emulator/launcher/goldfish",
            // Set any program arguments here.
            "args": [
                "@V",
                "-verbose",
                "-vmodule",
                "*ispla*=1",
            ],
            // OS specific settings
            "osx": {
                // Set any environment values here, not you would likely want to keep at least these
                "env": [
                    // We are pretending to be a bazel run..
                    "BUILD_WORKSPACE_DIRECTORY=${workspaceFolder}",
                    "BUILD_WORKING_DIRECTORY=${workspaceFolder}",
                    // Asan configuration.
                    "ASAN_OPTIONS=detect_odr_violation=0",
                    "LSAN_OPTIONS=suppressions=${workspaceFolder}/hardware/generic/goldfish/leak_suppressions.txt",
                    "TSAN_OPTIONS=second_deadlock_stack=1,suppressions=${workspaceFolder}/hardware/generic/goldfish/tsan_suppressions.txt",
                    "ASAN_SYMBOLIZER_PATH=${workspaceFolder}/prebuilts/clang/host/darwin-x86/clang-r563880b/bin/llvm-symbolizer",
                    // Disable crash reporting, the debugger could start tracking the crashpad-handler, which is usually not
                    // what you want to debug.
                    "ANDROID_EMU_ENABLE_CRASH_REPORTING=0"
                ],
            },
            "linux": {
                "env": [
                    "BUILD_WORKSPACE_DIRECTORY=${workspaceFolder}",
                    "BUILD_WORKING_DIRECTORY=${workspaceFolder}",
                    "ASAN_OPTIONS=detect_odr_violation=0",
                    "LSAN_OPTIONS=suppressions=${workspaceFolder}/hardware/generic/goldfish/leak_suppressions.txt",
                    "TSAN_OPTIONS=second_deadlock_stack=1,suppressions=${workspaceFolder}/hardware/generic/goldfish/tsan_suppressions.txt",
                    "ASAN_SYMBOLIZER_PATH=${workspaceFolder}/prebuilts/clang/host/linux-x86/clang-r563880b/bin/llvm-symbolizer",
                    "ANDROID_EMU_ENABLE_CRASH_REPORTING=0"
                ],
            },
            "cwd": "${workspaceFolder}",
            "debuggerRoot": "${workspaceFolder}",
            "sourceMap": [
                [
                    "/proc/self/cwd",
                    "${workspaceFolder}",
                ],
                // Down below you will find all the "local_repositories"
                // that we are using. If new repositories are introduced
                // you will have to add them here, or else symbols will
                // not be found.
                [
                    "external/+_repo_rules3+glib",
                    "${workspaceFolder}/third_party/glib"
                ],
                [
                    "external/gfxstream+",
                    "${workspaceFolder}/hardware/google/gfxstream"
                ],
                [
                    "external/+_repo_rules3+pixman",
                    "${workspaceFolder}/third_party/pixman"
                ],
                [
                    "external/+_repo_rules3+com_google_crashpad",
                    "${workspaceFolder}/third_party/crashpad"
                ],
                [
                    "external/aemu+",
                    "${workspaceFolder}/hardware/google/aemu"
                ],
            ],
            "preLaunchTask": "aemu: Build debug emulator",
            "stopOnEntry": false,
            "initCommands": [
                "settings set target.process.follow-fork-mode child",
                "process handle SIGUSR1 --pass true --stop false",
                "process handle SIGUSR2 --pass true --stop false"
            ]
        },
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "Debug Goldfish under Asan",
            // Replace <path_to_your_binary> with the actual path to your
            // binary. If you want to debug BUILD target
            // `//path/to:my_test`, the path to your binary will be
            // `${workspaceFolder}/bazel-bin/path/to/my_test`.
            "program": "${workspaceFolder}/bazel-bin/hardware/generic/goldfish/emulator/launcher/goldfish",
            // Set any program arguments here.
            "args": [
                "-avd",
                "V",
            ],
            "osx": {
                "env": [
                    "BUILD_WORKSPACE_DIRECTORY=${workspaceFolder}",
                    "BUILD_WORKING_DIRECTORY=${workspaceFolder}",
                    "ASAN_OPTIONS=detect_odr_violation=0",
                    "LSAN_OPTIONS=suppressions=${workspaceFolder}/hardware/generic/goldfish/leak_suppressions.txt",
                    "TSAN_OPTIONS=second_deadlock_stack=1,suppressions=${workspaceFolder}/hardware/generic/goldfish/tsan_suppressions.txt",
                    "ASAN_SYMBOLIZER_PATH=${workspaceFolder}/prebuilts/clang/host/darwin-x86/clang-r563880b/bin/llvm-symbolizer",
                    "ANDROID_EMU_ENABLE_CRASH_REPORTING=0"
                ],
            },
            "linux": {
                "env": [
                    "BUILD_WORKSPACE_DIRECTORY=${workspaceFolder}",
                    "BUILD_WORKING_DIRECTORY=${workspaceFolder}",
                    "ASAN_OPTIONS=detect_odr_violation=0",
                    "LSAN_OPTIONS=suppressions=${workspaceFolder}/hardware/generic/goldfish/leak_suppressions.txt",
                    "TSAN_OPTIONS=second_deadlock_stack=1,suppressions=${workspaceFolder}/hardware/generic/goldfish/tsan_suppressions.txt",
                    "ASAN_SYMBOLIZER_PATH=${workspaceFolder}/prebuilts/clang/host/linux-x86/clang-r563880b/bin/llvm-symbolizer",
                    "ANDROID_EMU_ENABLE_CRASH_REPORTING=0"
                ],
            },
            "cwd": "${workspaceFolder}",
            "debuggerRoot": "${workspaceFolder}",
            "sourceMap": [
                [
                    "/proc/self/cwd",
                    "${workspaceFolder}",
                ],
                [
                    "external/+_repo_rules3+glib",
                    "${workspaceFolder}/third_party/glib"
                ],
                [
                    "external/gfxstream+",
                    "${workspaceFolder}/hardware/google/gfxstream"
                ],
                [
                    "external/+_repo_rules3+pixman",
                    "${workspaceFolder}/third_party/pixman"
                ],
                [
                    "external/+_repo_rules3+com_google_crashpad",
                    "${workspaceFolder}/third_party/crashpad"
                ],
                [
                    "external/aemu+",
                    "${workspaceFolder}/hardware/google/aemu"
                ],
            ],
            "preLaunchTask": "aemu: Build emulator with asan",
            "stopOnEntry": false,
            "initCommands": [
                "settings set target.process.follow-fork-mode child",
                "process handle SIGUSR1 --pass true --stop false",
                "process handle SIGUSR2 --pass true --stop false"
            ]
        },
        {
            "type": "lldb-dap",
            "request": "launch",
            "name": "Debug Unit Test",
            // Replace <path_to_your_binary> with the actual path to your
            // binary. If you want to debug BUILD target
            // `//path/to:my_test`, you can run `bazel build //path/to:my_test`
            // and bazel will report the location of your binary.
            // `//path/to:my_test` is usually `${workspaceFolder}/bazel-bin/path/to/my_test`
            "program": "${workspaceFolder}/bazel-bin/hardware/generic/goldfish/android/async/eventloop_unittests",
            // Set any program arguments here.
            "args": [
                // "--gtest_filter=SensorDeviceTest.*",
            ],
            "osx": {
                "env": [
                    "BUILD_WORKSPACE_DIRECTORY=${workspaceFolder}",
                    "BUILD_WORKING_DIRECTORY=${workspaceFolder}",
                    "ASAN_OPTIONS=detect_odr_violation=0",
                    "LSAN_OPTIONS=suppressions=${workspaceFolder}/hardware/generic/goldfish/leak_suppressions.txt",
                    "TSAN_OPTIONS=second_deadlock_stack=1,suppressions=${workspaceFolder}/hardware/generic/goldfish/tsan_suppressions.txt",
                    "ASAN_SYMBOLIZER_PATH=${workspaceFolder}/prebuilts/clang/host/darwin-x86/clang-r563880b/bin/llvm-symbolizer",
                    "ANDROID_EMU_ENABLE_CRASH_REPORTING=0"
                ],
            },
            "linux": {
                "env": [
                    "BUILD_WORKSPACE_DIRECTORY=${workspaceFolder}",
                    "BUILD_WORKING_DIRECTORY=${workspaceFolder}",
                    "ASAN_OPTIONS=detect_odr_violation=0",
                    "LSAN_OPTIONS=suppressions=${workspaceFolder}/hardware/generic/goldfish/leak_suppressions.txt",
                    "TSAN_OPTIONS=second_deadlock_stack=1,suppressions=${workspaceFolder}/hardware/generic/goldfish/tsan_suppressions.txt",
                    "ASAN_SYMBOLIZER_PATH=${workspaceFolder}/prebuilts/clang/host/linux-x86/clang-r563880b/bin/llvm-symbolizer",
                    "ANDROID_EMU_ENABLE_CRASH_REPORTING=0"
                ],
            },
            "cwd": "${workspaceFolder}",
            "debuggerRoot": "${workspaceFolder}",
            "sourceMap": [
                [
                    "/proc/self/cwd",
                    "${workspaceFolder}",
                ],
                [
                    "external/+_repo_rules3+glib",
                    "${workspaceFolder}/third_party/glib"
                ],
                [
                    "external/gfxstream+",
                    "${workspaceFolder}/hardware/google/gfxstream"
                ],
                [
                    "external/+_repo_rules3+pixman",
                    "${workspaceFolder}/third_party/pixman"
                ],
                [
                    "external/+_repo_rules3+com_google_crashpad",
                    "${workspaceFolder}/third_party/crashpad"
                ],
                [
                    "external/aemu+",
                    "${workspaceFolder}/hardware/google/aemu"
                ],
            ],
            // "preLaunchTask": "aemu: Build emulator test suite",
            "stopOnEntry": false,
        },
        {
            "type": "lldb-dap",
            "request": "attach",
            "name": "Attach to PID (goldfish)",
            // Replace <path_to_your_binary> with the actual path to your
            // binary. If you want to debug BUILD target
            "program": "${workspaceFolder}/bazel-bin/hardware/generic/goldfish/emulator/launcher/goldfish",
            // Set the pid here
            "pid": 954478,
            "debuggerRoot": "${workspaceFolder}",
            "sourceMap": [
                [
                    "/proc/self/cwd",
                    "${workspaceFolder}",
                ],
                [
                    "external/+_repo_rules3+glib",
                    "${workspaceFolder}/third_party/glib"
                ],
                [
                    "external/gfxstream+",
                    "${workspaceFolder}/hardware/google/gfxstream"
                ],
                [
                    "external/+_repo_rules3+pixman",
                    "${workspaceFolder}/third_party/pixman"
                ],
                [
                    "external/+_repo_rules3+com_google_crashpad",
                    "${workspaceFolder}/third_party/crashpad"
                ],
                [
                    "external/aemu+",
                    "${workspaceFolder}/hardware/google/aemu"
                ],
            ],
            "initCommands": [
                "settings set target.process.follow-fork-mode child",
                "process handle SIGUSR1 --pass true --stop false",
                "process handle SIGUSR2 --pass true --stop false"
            ]
        },
        {
            "type": "lldb-dap",
            "request": "attach",
            "name": "Attach to next (goldfish)",
            // Replace <path_to_your_binary> with the actual path to your
            // binary. If you want to debug BUILD target
            "program": "${workspaceFolder}/bazel-bin/hardware/generic/goldfish/emulator/launcher/goldfish",
            "waitFor": true,
            "debuggerRoot": "${workspaceFolder}",
            "sourceMap": [
                [
                    "/proc/self/cwd",
                    "${workspaceFolder}",
                ],
                [
                    "external/+_repo_rules3+glib",
                    "${workspaceFolder}/third_party/glib"
                ],
                [
                    "external/gfxstream+",
                    "${workspaceFolder}/hardware/google/gfxstream"
                ],
                [
                    "external/+_repo_rules3+pixman",
                    "${workspaceFolder}/third_party/pixman"
                ],
                [
                    "external/+_repo_rules3+com_google_crashpad",
                    "${workspaceFolder}/third_party/crashpad"
                ],
                [
                    "external/aemu+",
                    "${workspaceFolder}/hardware/google/aemu"
                ],
            ],
            "initCommands": [
                "settings set target.process.follow-fork-mode child",
                "process handle SIGUSR1 --pass true --stop false",
                "process handle SIGUSR2 --pass true --stop false"
            ]
        },
    ]
}