{
    "bazel.buildifierExecutable": "@buildifier_prebuilt//:buildifier",
    "bazel.buildifierFixOnFormat": true,
    "mise.configureExtensionsUseSymLinks": true,
    "mise.updateOpenTerminalsEnvAutomatically": true,
    "commit-message-formatter.subjectMode": "split-ellipses",
    "commit-message-formatter.protectedPatterns": [
        "#",
        "Signed-off-by:",
        "Co-authored-by:",
        "Change-Id:",
        "Test:",
        "Fixes:",
        "Bug:"
    ],
    "commit-message-formatter.collapseMultipleEmptyLines": true,
    "files.eol": "\n", // Windows should not introduce CRLF.
    "files.exclude": {
        ".cache": true,
        ".repo": true,
        "**/.cache": true,
        "**/.DS_Store": true, // this is a default value
        "**/.git": true, // this is a default value
        "**/bazel-*": true,
    },
}