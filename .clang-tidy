# ------------------------------------------------------------------------------
# CLANG-TIDY CONFIGURATION: GOOGLE STANDARD
# ------------------------------------------------------------------------------

Checks:
  - '-*'                            # Disable all defaults
  # --- ENABLED CHECK GROUPS ---
  - 'bugprone-*'                   # Real bugs (narrowing, usage errors)
  - 'modernize-*'                  # Modern C++ (nullptr, override, auto)
  - 'performance-*'                # Micro-optimizations
  - 'readability-*'                # Code structure
  - 'google-*'                     # Google Style Guide enforcement
  - 'abseil-*'                     # Best practices for Abseil library
  - 'misc-*'                       # Miscellaneous hygiene

  # --- THE KILL LIST (Noise Suppression) ---
  # Explicitly disabled based on analysis of 16k+ warnings in our codebase.
  - '-misc-include-cleaner'                 # Flaky on system headers
  - '-readability-magic-numbers'            # Too strict for HAL/Driver code
  - '-readability-identifier-length'        # Allows 'i', 'n', 'q', 'x'
  - '-readability-named-parameter'          # Verbose
  - '-readability-implicit-bool-conversion' # Allow 'if (ptr)'
  - '-misc-non-private-member-variables-in-classes' # Allow public struct members

  # --- EXCLUSIONS ---
  - '-modernize-use-trailing-return-type'   # We do not use 'auto func() -> int'
  - '-google-readability-todo'              # We do not police TODO format

# Treat all warnings as errors (Strict Mode)
WarningsAsErrors: '*'
HeaderFileExtensions:         ['', 'h','hh','hpp','hxx']
ImplementationFileExtensions: ['c','cc','cpp','cxx']
HeaderFilterRegex: "^goldfish.*|^android.*|^\\w+"

CheckOptions:
  # --- Function Complexity —
  - key:    readability-function-size.StatementThreshold
    value:  '450'
  - key:    readability-function-cognitive-complexity.Threshold
    value:  '25'
  - key:    readability-function-cognitive-complexity.IgnoreMacros
    value:  'true'

  # --- Control Flow ---
  # Allow "if (cond) return;" on a single line
  - key:    readability-braces-around-statements.ShortStatementLines
    value:  1

  # --- NAMING CONVENTIONS (STANDARD GOOGLE STYLE) ---

  # 1. Variables & Parameters: snake_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.LocalConstantCase
    value: lower_case

  # 2. Class Members: snake_case_ (trailing underscore)
  - key: readability-identifier-naming.PrivateMemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.ProtectedMemberCase
    value: lower_case
  - key: readability-identifier-naming.ProtectedMemberSuffix
    value: _
  # Public members (structs) do not get a suffix
  - key: readability-identifier-naming.PublicMemberCase
    value: lower_case

  # 3. Functions: PascalCase (CamelCase)
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase

  # 4. Globals/Constants: kCamelCase
  - key: readability-identifier-naming.GlobalConstantCase
    value: CamelCase
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: k
  - key: readability-identifier-naming.StaticConstantCase
    value: CamelCase
  - key: readability-identifier-naming.StaticConstantPrefix
    value: k
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k

  # 5. Types: PascalCase
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.TypedefCase
    value: CamelCase
