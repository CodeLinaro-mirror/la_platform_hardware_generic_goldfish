# Use the Google style in this project.
BasedOnStyle: Google

# Some folks prefer to write "int& foo" while others prefer "int &foo".  The
# Google Style Guide only asks for consistency within a project, we chose
# "int& foo" for this project:
DerivePointerAlignment: false
PointerAlignment: Left

# The Google Style Guide only asks for consistency w.r.t. "east const" vs.
# "const west" alignment of cv-qualifiers. It encourages const west.
QualifierAlignment: Left

IncludeBlocks: Regroup
IncludeCategories:
  # Some platforms (namely msys) need wchar to be included BEFORE
  # anything else, especially strsafe.h.
  - Regex: '^<wchar.h>'
    Priority: 5
  # first, non system headers that are included like <> - these are all
  # local carveouts, and get sorted below c++ but before "" files
  - Regex: '^<(openssl/|gmock/|gtest/|zlib|zconf|benchmark/|google/|absl)'
    Priority: 30

  # Frequently we include these like "..."
  - Regex: '^"(openssl/|gmock/|gtest/|zlib|zconf|benchmark/|google/|absl)'
    Priority: 31
  # Next we will have the aemu libs.
  - Regex: '^"(aemu/|host-common/)'
    Priority: 32

  # first C system headers - they have a . in the filename
  - Regex: '^<.*\.'
    Priority: 10
  # then C++ system headers - no ., the only thing that will match now
  - Regex: '^<'
    Priority: 20
  # finally other "" includes go between system headers and our headers
  - Regex: '^"'
    Priority: 40

CommentPragmas: '(@copydoc|@copybrief|@see|@overload|@snippet)'
# Format raw string literals with a `pb` or `proto` tag as proto.
RawStringFormats:
- Language: TextProto
  Delimiters:
  - 'pb'
  - 'proto'
  BasedOnStyle: Google

---
Language: ObjC
BasedOnStyle: Google
ColumnLimit: 80
ObjCBlockIndentWidth: 2
---
Language: Proto
BasedOnStyle: Google
ColumnLimit: 80
...



