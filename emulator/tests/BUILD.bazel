        ],
        "//conditions:default": [],
    }),
    tags = [
        "exclusive-if-local",
        "manual",
        "requires-network",
    ],
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    test_class = "com.android.tools.idea.EmulatorTest",
    runtime_deps = ["//tools/emulator/tests:emulator.tests"],
)

test_suite(
