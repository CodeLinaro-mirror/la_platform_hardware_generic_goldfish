cc_library(
    name = "sample_device_impl",
    srcs = [
        "src/android/goldfish/sample-devices.h",
        "src/android/goldfish/sample-plugin.cpp",
    ],
    includes = ["src"],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//external/qemu:libchardev",
        "//external/qemu:libhwcore",
        # Every plugin should link against libmodule-common, as this will provide
        # the DSO_STAMP_FUN_STR symbol, which the qemu loader will check against!
        "//external/qemu:libmodule-common",
        "//external/qemu:qemu-headers",
    ],
    alwayslink = True,
)

cc_binary(
    name = "sample",
    linkshared = True,
    visibility = [
        "//visibility:public",
    ],
    deps = [":sample_device_impl"] +
           select({
               "@platforms//os:windows": [
                   "//external/qemu:qemu-system-x86_64.if",
               ],
               "//conditions:default": [],
           }),
)

cc_library(
    name = "sample_base_device_impl",
    srcs = [
        "src/android/goldfish/sample-base-plugin.cpp",
        "src/android/goldfish/sample-devices.h",
    ],
    includes = ["src"],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//external/qemu:libchardev",
        "//external/qemu:libhwcore",
        # Every plugin should link against libmodule-common, as this will provide
        # the DSO_STAMP_FUN_STR symbol, which the qemu loader will check against!
        "//external/qemu:libmodule-common",
        "//external/qemu:qemu-headers",
    ],
    alwayslink = True,
)

cc_binary(
    name = "sample-base",
    linkshared = True,
    visibility = [
        "//visibility:public",
    ],
    deps = [":sample_base_device_impl"] +
           select({
               "@platforms//os:windows": [
                   "//external/qemu:qemu-system-x86_64.if",
               ],
               "//conditions:default": [],
           }),
)
