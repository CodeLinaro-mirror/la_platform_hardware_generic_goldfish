load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//emulator/tools:cc_binary_with_manifest.bzl", "cc_binary_with_manifest")

cc_library(
    name = "logger",
    srcs = [
        "adb_breadcrumb_tracker.cc",
        "adb_message_logger.cc",
    ],
    hdrs = [
        "include/goldfish/adb/adb_breadcrumb_tracker.h",
        "include/goldfish/adb/adb_message_logger.h",
    ],
    defines = select({
        "@qemu//:goldfish_enabled": ["CONFIG_TRACE_GOLDFISH"],
        "//conditions:default": [],
    }),
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//emulator/crashreport:breadcrumb",
        "//emulator/crashreport:breadcrumb_proto",
        "//emulator/libs/perfetto:init",
        "//emulator/libs/proto_data_store",
        "//emulator/plugin/hal/connector:cable",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/strings",
        "@aemu//protos/services/diagnostic:breadcrumb_cc_proto",
    ],
)

cc_test(
    name = "logger_unittests",
    size = "medium",
    srcs = [
        "adb_breadcrumb_tracker_test.cc",
        "adb_message_logger_test.cc",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":logger",
        "//emulator/libs/system:test-headers",
        "//emulator/libs/test:googletest_main",
    ],
)

cc_binary_with_manifest(
    name = "adb_breadcrumb_tracker_perf",
    srcs = [
        "adb_breadcrumb_tracker_perf.cc",
    ],
    tags = ["benchmark"],
    deps = [
        ":logger",
        "@google_benchmark//:benchmark",
    ],
)
