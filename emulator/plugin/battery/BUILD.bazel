load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "headers",
    hdrs = [
        "include/goldfish/battery/goldfish_battery.h",
        "include/goldfish/devices/battery/battery.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//emulator/libs/async:async_api",
        "//emulator/plugin/avd_universe:battery",
    ],
)

cc_library(
    name = "battery",
    srcs = [
        "battery.cc",
        "goldfish_battery.c",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":headers",
        "//emulator/libs/async:async_api",
        "//emulator/libs/eventing",
        "//emulator/plugin/avd_universe:battery",
        "@qemu//:qemu-headers-exported",
    ],
    alwayslink = True,
)

cc_test(
    name = "battery_test",
    size = "small",
    srcs = [
        "battery.cc",
        "battery_test.cc",
    ],
    deps = [
        ":headers",
        "//emulator/libs/async:async_api",
        "//emulator/libs/async:async_testing",
        "//emulator/libs/eventing",
        "//emulator/libs/test:googletest_main",
        "//emulator/plugin/avd_universe:battery",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:check",
    ],
)
