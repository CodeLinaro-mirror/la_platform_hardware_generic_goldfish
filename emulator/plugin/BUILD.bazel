cc_library(
    name = "registration",
    srcs = [
        "src/android/goldfish/qemu-plugin-registration.c",
    ],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//external/qemu:libhwcore",
    ],
)

cc_library(
    name = "sample_device_impl",
    srcs = [
        "src/android/goldfish/sample-plugin.c",
    ],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//external/qemu:libchardev",
        "//external/qemu:libhwcore",
        "//external/qemu:libmodule-common",
