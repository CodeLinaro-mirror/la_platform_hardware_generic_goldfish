load("@rules_cc//cc:defs.bzl", "cc_binary")

[
    cc_binary(
        name = "goldfish_" + arch,
        srcs = ["plugin.cc"],
        dynamic_deps = [
            "@glib//glib:glib_shared",
            "@glib//gmodule:gmodule_shared",
        ],
        linkopts = select({
            "@platforms//os:macos": [
                "-undefined dynamic_lookup",
                "-Wl,-ObjC",
                "-framework VideoToolbox",
                "-framework CoreMedia",
                "-framework AVFoundation",
                "-framework CoreVideo",
                "-framework Foundation",
            ],
            "@platforms//os:windows": [
                "strmiids.lib",
                "uuid.lib",
                "ole32.lib",
                "oleaut32.lib",
            ],
            "//conditions:default": [],
        }),
        linkshared = True,
        target_compatible_with = select({
            # We only ship the plugin whose guest arch matches the host:
            # aarch64 on macOS, x86_64 on Linux and Windows.
            "@platforms//os:macos": [] if arch == "aarch64" else ["@platforms//:incompatible"],
            "@platforms//os:linux": [] if arch == "x86_64" else ["@platforms//:incompatible"],
            "@platforms//os:windows": [] if arch == "x86_64" else ["@platforms//:incompatible"],
            "//conditions:default": ["@platforms//:incompatible"],
        }),
        visibility = ["//visibility:public"],
        win_def_file = select({
            "@platforms//os:windows": "goldfish_" + arch + ".def",
            "//conditions:default": None,
        }),
        deps = [
            "//emulator/crashreport:crash_reporter",
            "//emulator/crashreport:debug",
            "//emulator/libs/logging:color_log_sink",
            "//emulator/libs/perfetto:init",
            "//emulator/libs/perfetto:qemu_trace_bridge",
            "//emulator/plugin/adb-vsock",
            "//emulator/plugin/avd:avd_finalize",
            "//emulator/plugin/avd:avd_start",
            "//emulator/plugin/avd:global_event_loop",
            "//emulator/plugin/battery",
            "//emulator/plugin/grpc",
            "//emulator/plugin/netsim:netsim-chardev",
            "//emulator/plugin/netsim:netsim-netdev",
            "//emulator/plugin/netsim:netsim_connection",
            "//emulator/plugin/virtio-input-android",
            "//emulator/plugin/virtio-wifi",
            "//emulator/plugin/vminterface:vm_ops",
            "//emulator/plugin/webrtc",
            "//emulator/tools:aemu_version",
            "@abseil-cpp//absl/debugging:failure_signal_handler",
            "@abseil-cpp//absl/debugging:symbolize",
            "@abseil-cpp//absl/log",
            "@abseil-cpp//absl/log:structured",
            "@qemu//:aemu_func_defs",
            "@qemu//:qemu-headers-exported",
            "//emulator/plugin/vsock_goldfish:vsock_impl_" + arch,
            "@glib//glib:glib_import",
            "@glib//gmodule:gmodule_import",
        ] + select({
            "@platforms//os:windows": [
                "@qemu//:qemu-system-" + arch + ".if",
                "//emulator/crashreport:breadcrumb",
            ],
            "//conditions:default": [
                "//emulator/crashreport:breadcrumb",
            ],
        }) + [
            # crashreport dep must go after the windows compat dep.
            # buildifier: leave-alone
            "//emulator/crashreport:crash_system",
        ],
    )
    for arch in [
        "aarch64",
        "x86_64",
    ]
]
