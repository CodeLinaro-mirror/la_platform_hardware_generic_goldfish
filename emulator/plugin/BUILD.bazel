load("@rules_cc//cc:defs.bzl", "cc_binary")

[
    [
        cc_binary(
            name = "goldfish_" + arch,
            srcs = ["plugin.cpp"],
            linkopts = select({
                "@platforms//os:macos": ["-undefined dynamic_lookup"],
                "//conditions:default": [],
            }),
            linkshared = True,
            visibility = ["//visibility:public"],
            win_def_file = select({
                "@platforms//os:windows": "goldfish_" + arch + ".def",
                "//conditions:default": None,
            }),
            deps = [
                "//hardware/generic/goldfish/emulator/plugin/adb-vsock",
                "//hardware/generic/goldfish/emulator/plugin/avd",
                "//hardware/generic/goldfish/emulator/plugin/battery",
                "//hardware/generic/goldfish/emulator/plugin/grpc",
                "//hardware/generic/goldfish/emulator/plugin/netsim:netsim-chardev",
                "//hardware/generic/goldfish/emulator/plugin/netsim:netsim-netdev",
                "//hardware/generic/goldfish/emulator/plugin/virtio-input-android",
                "//hardware/generic/goldfish/emulator/plugin/virtio-wifi",
                "//hardware/generic/goldfish/emulator/plugin/vminterface:vm_ops",
                "//third_party/qemu:aemu_func_defs",
                "@abseil-cpp//absl/debugging:failure_signal_handler",
                "@abseil-cpp//absl/debugging:symbolize",
                "@abseil-cpp//absl/log",
                "//hardware/generic/goldfish/emulator/plugin/vsock_goldfish:vsock_impl_" + arch,
            ] + select({
                "@platforms//os:windows": [
                    "//hardware/generic/goldfish/android/windows/posix:compat",
                    "//third_party/qemu:qemu-system-" + arch + ".if",
                ],
                "//conditions:default": [],
            }) + [
                # crashreport dep must go after the windows compat dep.
                # buildifier: leave-alone
                "//hardware/generic/goldfish/emulator/crashreport:init",
            ],
        ),
    ]
    for arch in [
        "riscv64",
        "aarch64",
        "x86_64",
    ]
]
