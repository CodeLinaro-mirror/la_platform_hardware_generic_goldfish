load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "goldfish_vsock_hdrs",
    hdrs = [
        "include/goldfish/vsock/connect.h",
        "include/goldfish/vsock/listen.h",
        "include/goldfish/vsock/snapshot.h",
        "include/goldfish/vsock/vsock_low_level.h",
        "include/goldfish/vsock/vsock_port_fwd.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//hardware/generic/goldfish/android/async:async_api",
        "//third_party/qemu:qemu-headers",
    ],
)

[cc_library(
    name = "vsock_impl_" + arch,
    srcs = [
        "vsock.cpp",
        "vsock_low_level.c",
        "vsock_port_fwd.cpp",
    ],
    defines = [
        "COMPILING_PER_TARGET",
        'CONFIG_TARGET=\\"' + arch + '-softmmu-config-target.h\\"',
        'CONFIG_DEVICES=\\"' + arch + '-softmmu-config-devices.h\\"',
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":goldfish_vsock_hdrs",
        "//hardware/generic/goldfish/android/async:async_api",
        "//hardware/generic/goldfish/android/async:async_impl",
        "//hardware/generic/goldfish/android/async:libuv_event_loop",
        "//hardware/generic/goldfish/android/async:libuv_sockets",
        "//hardware/generic/goldfish/android/async:qemu_event_loop",
        "//hardware/generic/goldfish/android/logging:absl-c-bridge",
        "//hardware/generic/goldfish/emulator/hal/connector:cable",
        "//hardware/generic/goldfish/emulator/hal/connector:connection_awaiter",
        "//hardware/generic/goldfish/emulator/hal/plug:hal_plug_factory",
        "//hardware/generic/goldfish/emulator/libs/SocketBuffer",
        "//hardware/generic/goldfish/emulator/libs/UniqueIdAllocator",
        "//hardware/generic/goldfish/emulator/libs/archive:QEMUFileArchive",
        "//hardware/generic/goldfish/emulator/libs/debug",
        "//hardware/generic/goldfish/emulator/plugin/avd:avd_hdrs",
        "//third_party/qemu:qemu-headers",
        "@aemu//base:event-support",
    ],
    alwayslink = True,
) for arch in [
    "riscv64",
    "aarch64",
    "x86_64",
]]
