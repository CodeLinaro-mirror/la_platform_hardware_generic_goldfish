load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//emulator/tools:cc_binary_with_manifest.bzl", "cc_binary_with_manifest")

cc_library(
    name = "goldfish_vsock_hdrs",
    hdrs = [
        "include/goldfish/vsock/clear.h",
        "include/goldfish/vsock/connect.h",
        "include/goldfish/vsock/listen.h",
        "include/goldfish/vsock/snapshot.h",
        "include/goldfish/vsock/vsock_low_level.h",
        "include/goldfish/vsock/vsock_port_fwd.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//emulator/libs/async:async_api",
        "@qemu//:qemu-headers-exported",
    ],
)

cc_library(
    name = "vsock_core",
    srcs = [
        "vsock.cc",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":goldfish_vsock_hdrs",
        "//emulator/libs/SocketBuffer",
        "//emulator/libs/UniqueIdAllocator",
        "//emulator/libs/archive:QEMUFileArchive",
        "//emulator/libs/archive:collections",
        "//emulator/libs/debug",
        "//emulator/libs/perfetto:init",
        "//emulator/libs/synchronization",
        "//emulator/plugin/hal/connector:cable",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/synchronization",
        "@qemu//:qemu-headers-exported",
    ],
    alwayslink = True,
)

[cc_library(
    name = "vsock_impl_" + arch,
    srcs = [
        "vsock_low_level.c",
        "vsock_port_fwd.cc",
    ],
    defines = [
        "COMPILING_PER_TARGET",
        'CONFIG_TARGET=\\"' + arch + '-softmmu-config-target.h\\"',
        'CONFIG_DEVICES=\\"' + arch + '-softmmu-config-devices.h\\"',
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":goldfish_vsock_hdrs",
        ":vsock_core",
        "//emulator/libs/async:libuv_event_loop",
        "//emulator/libs/async:libuv_sockets",
        "//emulator/libs/async:qemu_event_loop",
        "//emulator/libs/async:threaded_event_loop",
        "//emulator/libs/eventing",
        "//emulator/libs/logging:absl_c_bridge",
        "//emulator/libs/network",
        "//emulator/plugin/avd:avd_info",
        "//emulator/plugin/avd:global_event_loop",
        "//emulator/plugin/hal/connector:cable",
        "//emulator/plugin/hal/connector:connection_awaiter",
        "//emulator/plugin/hal/guest-status",
        "//emulator/plugin/hal/plug:hal_plug_factory",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@qemu//:qemu-headers-exported",
    ],
    alwayslink = True,
) for arch in [
    "aarch64",
    "x86_64",
]]

cc_test(
    name = "vsock_unittests",
    size = "small",
    srcs = [
        "vsock_test.cc",
    ],
    deps = [
        ":goldfish_vsock_hdrs",
        ":vsock_core",
        "//emulator/plugin/hal/connector:cable",
        "@googletest//:gtest_main",
        "@qemu//:qemu-headers-exported",
    ],
)

cc_binary_with_manifest(
    name = "vsock_perf",
    srcs = [
        "vsock_perf.cc",
    ],
    tags = ["benchmark"],
    visibility = ["//visibility:public"],
    deps = [
        ":goldfish_vsock_hdrs",
        ":vsock_core",
        "//emulator/libs/async:libuv_event_loop",
        "//emulator/libs/async:threaded_event_loop",
        "//emulator/plugin/adb-vsock/logger",
        "//emulator/plugin/hal/connector:cable",
        "//emulator/plugin/hal/plug:hal_plug",
        "//emulator/plugin/hal/plug:hal_plug_factory",
        "@abseil-cpp//absl/synchronization",
        "@google_benchmark//:benchmark",
        "@qemu//:qemu-headers-exported",
    ],
)
