load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "virtualscene",
    srcs = [
        "virtualscene.cc",
        "virtualscene_image_provider.cc",
        "virtualscene_image_provider.h",
    ],
    hdrs = ["include/goldfish/camera_image_providers/virtualscene/virtualscene.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//emulator/libs/debug",
        "//emulator/libs/imaging",
        "//emulator/libs/ver",
        "//emulator/plugin/hal/camera:image_provider_api",
