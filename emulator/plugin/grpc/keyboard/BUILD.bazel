load("@goldfish_build//rules:clang_tidy.bzl", "clang_tidy_test")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "keyconversion",
    srcs = [
        "dom_key.h",
        "dom_key_data.inc",
        "key_conversion.cc",
        "keycode_converter_data.inc",
    ],
    hdrs = ["include/android/emulation/control/keyboard/key_conversion.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//emulator/libs/async:async_api",
        "@qemu//:qemu-headers-exported",
    ],
)

cc_library(
    name = "keyboard",
    srcs = ["key_event_sender.cc"],
    hdrs = [
        "include/android/emulation/control/keyboard/key_event_sender.h",
        # Internal to this package; see the header.
        "key_event_emitter.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        ":keyconversion",
        "//emulator/libs/async:async_api",
        "@abseil-cpp//absl/functional:function_ref",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@aemu//protos/services/emulator-controller:emulator_controller_cc_proto",
        "@qemu//:qemu-headers-exported",
    ],
)

cc_library(
    name = "qemu_keyboard_sink",
    srcs = ["qemu_keyboard_sink.cc"],
    hdrs = ["include/android/emulation/control/keyboard/qemu_keyboard_sink.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        ":keyboard",
        ":keyconversion",
        "//emulator/libs/async:async_api",
        "//emulator/plugin/grpc/input:keyboard_sink",
        "@abseil-cpp//absl/log:check",
        "@qemu//:qemu-headers-exported",
    ],
)

cc_library(
    name = "key_code_resolver",
    srcs = ["key_code_resolver.cc"],
    hdrs = ["include/android/emulation/control/keyboard/key_code_resolver.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        ":keyconversion",
        "@aemu//protos/services_v2:input_service_cc_proto",
    ],
)

cc_library(
    name = "test_qemu_input_stub",
    testonly = True,
    srcs = ["qemu_input_stub.c"],
    visibility = ["//visibility:public"],
    deps = ["@qemu//:qemu-headers-exported"],
)

cc_test(
    name = "keyboard_unittests",
    size = "small",
    srcs = ["key_converter_test.cc"],
    deps = [
        ":keyconversion",
        ":test_qemu_input_stub",
        "//emulator/libs/system:test-headers",
        "//emulator/libs/test:googletest_main",
        "@qemu//:qemu-headers-exported",
    ],
)

# Defines its own recording QEMU input stubs, so it must not link :test_qemu_input_stub.
cc_test(
    name = "key_event_sender_unittests",
    size = "small",
    srcs = ["key_event_sender_test.cc"],
    deps = [
        ":keyboard",
        ":keyconversion",
        "//emulator/libs/async:async_testing",
        "//emulator/libs/test:googletest_main",
        "@aemu//protos/services/emulator-controller:emulator_controller_cc_proto",
        "@qemu//:qemu-headers-exported",
    ],
)

# Defines its own recording QEMU input stubs, so it must not link :test_qemu_input_stub.
cc_test(
    name = "qemu_keyboard_sink_unittests",
    size = "small",
    srcs = ["qemu_keyboard_sink_test.cc"],
    deps = [
        ":keyboard",
        ":keyconversion",
        ":qemu_keyboard_sink",
        "//emulator/libs/async:async_testing",
        "//emulator/libs/test:googletest_main",
        "@aemu//protos/services/emulator-controller:emulator_controller_cc_proto",
        "@qemu//:qemu-headers-exported",
    ],
)

cc_test(
    name = "key_code_resolver_unittests",
    size = "small",
    srcs = ["key_code_resolver_test.cc"],
    deps = [
        ":key_code_resolver",
        ":test_qemu_input_stub",
        "//emulator/libs/test:googletest_main",
        "@aemu//protos/services_v2:input_service_cc_proto",
        "@qemu//:qemu-headers-exported",
    ],
)

clang_tidy_test(
    name = "tidy",
    targets = [
        ":keyconversion",
        ":keyboard",
        ":test_qemu_input_stub",
        ":keyboard_unittests",
        ":key_event_sender_unittests",
        ":qemu_keyboard_sink",
        ":qemu_keyboard_sink_unittests",
        ":key_code_resolver",
        ":key_code_resolver_unittests",
    ],
    tidy_config_file = "//:clang_tidy_config",
)
