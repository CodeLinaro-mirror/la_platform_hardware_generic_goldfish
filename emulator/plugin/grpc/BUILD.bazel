    hdrs = ["emulator_advertisement.h"],
    deps = [
        "//android/files:ini_file",
        "//android/sockets",
        "@aemu//base:aemu-base",
    ],
)

cc_library(
    name = "grpc",
    srcs = [
        "grpc.cc",
        "grpc_display.c",
        "grpc_display.h",
    ],
    hdrs = ["include/goldfish/grpc/grpc.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        ":emulator_advertisement",
        "//android/async:qemu_event_loop",
        "//emulator/config:hardware_config",
        "//emulator/grpc/event-stream",
        "//emulator/grpc/services-stack",
        "//emulator/grpc/services/emulator_controller:emulator_controller_cc_grpc",
        "//emulator/libs/display",
        "//emulator/plugin/avd:impl",
        "//emulator/tools:aemu_version",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/time",
        "@grpc//:grpc++_reflection",
        "@qemu//:qemu-headers",
    ],
    alwayslink = True,
