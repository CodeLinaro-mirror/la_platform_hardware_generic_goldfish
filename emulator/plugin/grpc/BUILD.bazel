load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

cc_library(
    name = "headers",
    hdrs = [
        "include/android/goldfish/display/QemuDisplayTransformer.h",
        "include/android/goldfish/display/SharedMemoryLibrary.h",
        "include/android/goldfish/grpc-service-device.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//hardware/generic/goldfish/emulator/android-grpc/event-stream",
        "//hardware/generic/goldfish/emulator/android-grpc/services/emulator-controller/proto:emulator_controller_cc_grpc",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/time",
    ],
)

cc_library(
    name = "grpc_device_impl",
    srcs = [
        "src/android/goldfish/display/QemuDisplayTransformer.cpp",
        "src/android/goldfish/display/SharedMemoryLibrary.cpp",
        "src/android/goldfish/grpc-service-device.c",
        "src/android/goldfish/grpc-service-impl.cpp",
    ],
    includes = [
        "include",
        "src",
    ],
    linkstatic = False,
    visibility = [
        "//visibility:public",
    ],
    deps = [
        ":headers",
        "//external/crosvm/rutabaga_gfx",
        "//external/qemu:libmodule-common",
        "//external/qemu:qemu-headers",
        "//hardware/generic/goldfish/emulator/agents",
        "//hardware/generic/goldfish/emulator/android-grpc/event-stream",
        "//hardware/generic/goldfish/emulator/android-grpc/services-stack",
        "//hardware/generic/goldfish/emulator/hal/vminterface:vm_with_cpu_stub",  # TODO(jansene): Use cpu based version..
        "//hardware/generic/goldfish/emulator/plugin/avd:avd_hdrs",
        "@com_github_grpc_grpc//:grpc++_reflection",
        "@com_google_absl//absl/strings",
        "@pixman//:pixman-1",
        "@pixman//:pixman_simd",
    ],
    alwayslink = True,
)

cc_binary(
    name = "grpc",
    linkshared = True,
    visibility = [
        "//visibility:public",
    ],
    deps = [":grpc_device_impl"] +
           select({
               "@platforms//os:windows": [
                   "//external/qemu:qemu-system-x86_64.if",
               ],
               "//conditions:default": [],
           }),
)

cc_test(
    name = "display_unittests",
    srcs = [
        "test/DisplayTest.cpp",
    ],
    includes = ["test"],
    deps = [
        ":grpc_device_impl",
        "@com_google_googletest//:gtest_main",
    ],
)
