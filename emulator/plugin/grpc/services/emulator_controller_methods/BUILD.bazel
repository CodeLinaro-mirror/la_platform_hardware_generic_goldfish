load("@aemu//tools/clang_tidy:defs.bzl", "clang_tidy_test")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//emulator/tools:cc_binary_with_manifest.bzl", "cc_binary_with_manifest")
load("//emulator/tools:plugins.bzl", "collect_plugins")

package(default_visibility = ["//visibility:public"])

collect_plugins(
    name = "binplace",
    output_dir = ".",
    plugins = [
        "@glib//glib:glib_shared",
        "@glib//gmodule:gmodule_shared",
    ],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "emulator_controller_methods",
    srcs = [
        "audio_stream_writer.cc",
        "battery_service.cc",
        "clipboard_service.cc",
        "display_service.cc",
        "fingerprint_service.cc",
        "gps_service.cc",
        "sensor_service.cc",
        "status_service.cc",
        "vm_service.cc",
    ],
    hdrs = [
        "audio_stream_writer.h",
        "battery_service.h",
        "clipboard_service.h",
        "display_service.h",
        "fingerprint_service.h",
        "gps_service.h",
        "notification_store.h",
        "notification_stream_writer.h",
        "sensor_service.h",
        "status_service.h",
        "vm_service.h",
    ],
    deps = [
        "//emulator/libs/async:async_api",
        "//emulator/libs/cpu",
        "//emulator/libs/display_pipeline:core",
        "//emulator/libs/display_pipeline:cpu_pipeline",
        "//emulator/libs/fps_calculator",
        "//emulator/libs/grpc_utils:absl_translate",
        "//emulator/libs/grpc_utils:async",
        "//emulator/libs/grpc_utils:event-stream",
        "//emulator/libs/hardware_config",
        "//emulator/libs/ini_file",
        "//emulator/libs/parsing:resizable_display_config",
        "//emulator/libs/perfetto:init",
        "//emulator/libs/shared_memory",
        "//emulator/libs/sockets",
        "//emulator/plugin/audio:qemu_audio_capture",
        "//emulator/plugin/avd:avd_info",
        "//emulator/plugin/avd:avd_properties",
        "//emulator/plugin/avd:avd_universe",
        "//emulator/plugin/display",
        "//emulator/plugin/display:write_png",
        "//emulator/plugin/grpc/keyboard",
        "//emulator/plugin/vminterface",
        "//emulator/tools:aemu_version",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/time",
        "@aemu//protos/services/emulator-controller:emulator_controller_cc_grpc",
    ],
)

cc_test(
    name = "emulator_controller_methods_test",
    size = "small",
    srcs = [
        "audio_stream_writer_test.cc",
        "display_service_test.cc",
        "fingerprint_service_test.cc",
        "notification_store_test.cc",
        "qemu_stubs.c",
        "sensor_service_test.cc",
        "status_service_test.cc",
        "test/grpc_service_test.h",
        "vm_service_test.cc",
    ],
    data = [":binplace"],
    dynamic_deps = [
        "@glib//glib:glib_shared",
        "@glib//gmodule:gmodule_shared",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":emulator_controller_methods",
        "//emulator/libs/async:async_testing",
        "//emulator/libs/async:libuv_event_loop",
        "//emulator/libs/async:threaded_event_loop",
        "//emulator/libs/cpu",
        "//emulator/libs/display_pipeline:cpu_pipeline",
        "//emulator/libs/hardware_config:fake_hardware_config",
        "//emulator/libs/process",
        "//emulator/libs/test:googletest_main",
        "//emulator/plugin/audio:test_qemu_audio_stub",
        "//emulator/plugin/avd:fake_avd_universe",
        "//emulator/plugin/display:test-display",
        "//emulator/plugin/grpc/keyboard:test_qemu_input_stub",
        "//emulator/plugin/vminterface:test_vminterface",
        "//emulator/plugin/vminterface:vminterface-test",
        "//emulator/tools:aemu_version",
        "@abseil-cpp//absl/synchronization",
    ],
)

cc_binary_with_manifest(
    name = "display_service_perf",
    srcs = ["display_service_perf.cc"],
    tags = ["benchmark"],
    deps = [
        "//emulator/libs/display_pipeline:cpu_pipeline",
        "@aemu//protos/services/emulator-controller:emulator_controller_cc_grpc",
        "@google_benchmark//:benchmark",
    ],
)

clang_tidy_test(
    name = "tidy",
    targets = [
        ":emulator_controller_methods",
        ":emulator_controller_methods_test",
        ":display_service_perf",
    ],
    tidy_config_file = "//:clang_tidy_config",
)
