    name = "in_process_rtc_service_test",
    srcs = ["in_process_rtc_service_test.cc"],
    copts = select({
        "@platforms//os:windows": ["/GR-"],
        "//conditions:default": ["-fno-rtti"],
    }),
    linkopts = select({
        "@platforms//os:macos": [
            "-Wl,-ObjC",
            "-framework VideoToolbox",
            "-framework CoreMedia",
            "-framework AVFoundation",
            "-framework CoreVideo",
            "-framework Foundation",
