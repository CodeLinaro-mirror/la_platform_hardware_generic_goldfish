        "vm_lock.cc",
        "vm_lock.h",
    ],
    includes = ["src"],
    deps = [
        "@abseil-cpp//absl/synchronization",
        "@qemu//:qemu-headers",
    ],
)

cc_library(
    name = "machine_info",
    srcs = ["qemu_machine_info.c"],
    hdrs = ["src/vm/qemu_machine_info.h"],
    includes = ["src"],
    visibility = ["//visibility:public"],
    deps = ["@qemu//:qemu-headers"],
)

cc_library(
    name = "fake_machine_info",
    srcs = ["fake_machine_info.c"],
    hdrs = ["src/vm/qemu_machine_info.h"],
    includes = ["src"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "vminterface",
    hdrs = ["include/android/goldfish/vm_interface.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = ["@abseil-cpp//absl/strings:str_format"],
)

cc_library(
    name = "vm_ops",
    srcs = ["qemu_vm_operations.cc"],
    visibility = ["//visibility:public"],
    deps = [
        ":machine_info",
        ":vm_lock",
        ":vminterface",
        "@qemu//:qemu-headers",
    ],
)

cc_library(
    name = "vm_ops_with_fake_machine_info",
