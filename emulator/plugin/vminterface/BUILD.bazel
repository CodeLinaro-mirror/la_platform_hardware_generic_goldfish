    deps = [
        ":vm_lock",
        ":vm_ops_with_fake_machine_info",
        ":vminterface",
        "@abseil-cpp//absl/synchronization",
    ],
)

cc_test(
    name = "vminterface_unittests",
    testonly = True,
    srcs = ["vm_test.cc"],
    includes = ["test"],
    visibility = ["//visibility:public"],
    deps = [
        ":vminterface-test",
        "//android/system:googletest_main",
        "//android/system:test-headers",
    ],
)

cc_library(
    name = "test_vminterface",
    testonly = True,
    hdrs = ["test/FakeVmOperations.h"],
    includes = ["test"],
    visibility = ["//visibility:public"],
    deps = [":vminterface"],
