load("@rules_cc//cc:cc_library.bzl", "cc_library")

# Create implementations for each target.
[cc_library(
    name = arch,
    srcs = [
        "src/android/goldfish/qemu-plugin-registration.c",
    ],
    defines = [
        "COMPILING_PER_TARGET",
        'CONFIG_TARGET=\\"' + arch + '-softmmu-config-target.h\\"',
        'CONFIG_DEVICES=\\"' + arch + '-softmmu-config-devices.h\\"',
    ],
    includes = ["src"],
    visibility = [
        "//visibility:public",
    ],
    deps = ["//third_party/qemu:qemu-headers"],
    alwayslink = 1,
) for arch in [
    "riscv64",
    "aarch64",
    "x86_64",
]]
