load("@bazel_lib//lib:copy_file.bzl", "copy_file")
load("@bazel_lib//lib:directory_path.bzl", "make_directory_path")
load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")
load("@bazel_skylib//rules:select_file.bzl", "select_file")
load("@goldfish_build//rules/native:native_binaries.bzl", "stripped_binaries")
load("@rules_license//rules:license.bzl", "license")
load("@rules_license//rules:license_kind.bzl", "license_kind")
load("@rules_pkg//pkg:mappings.bzl", "filter_directory", "pkg_attributes", "pkg_filegroup", "pkg_files")
load("@rules_pkg//pkg:zip.bzl", "pkg_zip")
load(
    "//emulator/tools:notice.bzl",
    "generate_notice_file",
)
load(
    "//emulator/tools:packaging.bzl",
    "breakpad_symbols_pkg",
    "build_id_from_command_line",
    "native_symbols_pkg",
    "remapped_pkg_files",
    "source_properties",
)
load(
    "//emulator/tools:transitions.bzl",
    "internal_release",
)

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

bool_flag(
    name = "internal_fishtank",
    build_setting_default = False,
)

# Optional override path for the fishtank directory.
# When specified, bypasses downloading and unzipping the prebuilt fishtank release.
# Usage: --@goldfish//emulator:fishtank_path=/path/to/fishtank
string_flag(
    name = "fishtank_path",
    build_setting_default = "",
)

config_setting(
    name = "internal_fishtank_enabled",
    flag_values = {":internal_fishtank": "True"},
)

config_setting(
    name = "internal_fishtank_disabled",
    flag_values = {":internal_fishtank": "False"},
)

selects.config_setting_group(
    name = "use_linux_internal_fishtank",
    match_all = [
        ":internal_fishtank_enabled",
        "@platforms//os:linux",
    ],
)

selects.config_setting_group(
    name = "use_linux_fishtank",
    match_all = [
        ":internal_fishtank_disabled",
        "@platforms//os:linux",
    ],
)

exports_files(["LICENSE"])

license(
    name = "license",
    license_kinds = [
        ":SPDX-license-identifier-Apache-2.0",
    ],
    visibility = [":__subpackages__"],
)

license_kind(
    name = "SPDX-license-identifier-Apache-2.0",
    conditions = ["notice"],
    url = "https://spdx.org/licenses/Apache-2.0.html",
)

# You can pass in the build id from the bazel command line flag
# as follows:
# --@goldfish//emulator:build_id=P123
build_id_from_command_line(
    name = "build_id",
    build_setting_default = "developer",
)

config_setting(
    name = "is_developer_build_id",
    flag_values = {":build_id": "developer"},
)

bool_flag(
    name = "is_presubmit",
    build_setting_default = False,
)

config_setting(
    name = "is_presubmit_build",
    flag_values = {":is_presubmit": "True"},
)

selects.config_setting_group(
    name = "is_developer_build",
    match_any = [
        ":is_developer_build_id",
        ":is_presubmit_build",
    ],
)

source_properties(
    name = "source_properties",
    out = "source.properties",
    aemu_version = "//emulator/tools:aemu_version_info",
)

pkg_files(
    name = "source_properties_pkg",
    srcs = [":source_properties"],
)

filegroup(
    name = "launcher_binaries",
    srcs = [
        "//emulator/launcher",
        "//emulator/launcher/emulator-check",
        "//emulator/launcher/mksdcard",
    ],
)

filegroup(
    name = "qemu_binaries",
    srcs = [
        "//emulator/crashreport",
        "//third_party/sparse:img2simg",
        "@qemu//:qemu-img",
        "@crashpad//handler:crashpad_handler",
        #"@netsim//:netsimd",
    ] + select({
        "@platforms//os:windows": [
            "@goldfish_prebuilts_common//netsim:netsim_cli_windows_x86_64",
            "@goldfish_prebuilts_common//netsim:netsim_windows_x86_64",
            "@qemu//:qemu-system-aarch64",
            "@qemu//:qemu-system-x86_64",
        ],
        "@platforms//os:macos": [
            "@goldfish_prebuilts_common//netsim:netsim_cli_darwin_aarch64",
            "@goldfish_prebuilts_common//netsim:netsim_darwin_aarch64",
            "@qemu//:qemu-system-aarch64_signed",
            "@qemu//:qemu-system-x86_64_signed",
        ],
        "//conditions:default": [
            "@goldfish_prebuilts_common//netsim:netsim_linux_x86_64",
            "@goldfish_prebuilts_common//netsim:netsim_cli_linux_x86_64",
            "@qemu//:qemu-system-x86_64",
            "@qemu//:qemu-system-aarch64",
            # We currently don't have riscv images
            # "@qemu//:qemu-system-riscv64",
        ],
    }),
)

filegroup(
    name = "egl_binaries",
    srcs = select({
        "@platforms//os:macos": [
            "@goldfish_prebuilts_common//ANGLE:lib_darwin_aarch64",
            "@goldfish_prebuilts_common//vulkan:icds_darwin_aarch64",
            "@goldfish_prebuilts_common//vulkan:lib_darwin_aarch64",
        ],
        "@platforms//os:linux": [
            "@goldfish_prebuilts_common//swiftshader:lib_linux_x86_64",
        ],
        "@platforms//os:windows": [
            "@goldfish_prebuilts_common//ANGLE:lib_windows_x86_64",
            "@goldfish_prebuilts_common//vulkan:icds_windows_x86_64",
            "@goldfish_prebuilts_common//vulkan:lib_windows_x86_64",
        ],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "vulkan_binaries",
    srcs = select({
        "@platforms//os:macos": [
            "@goldfish_prebuilts_common//vulkan:icds_darwin_aarch64",
            "@goldfish_prebuilts_common//vulkan:lib_darwin_aarch64",
        ],
        "@platforms//os:linux": [
            "@goldfish_prebuilts_common//vulkan:icds_linux_x86_64",
            "@goldfish_prebuilts_common//vulkan:lib_linux_x86_64",
            "@mesa3d//:generate_lvp_icd",
            "@mesa3d//:vulkan_lvp",
        ],
        "@platforms//os:windows": [
            "@goldfish_prebuilts_common//vulkan:icds_windows_x86_64",
            "@goldfish_prebuilts_common//vulkan:lib_windows_x86_64",
        ],
        "//conditions:default": [],
    }),
)

filegroup(
    name = "plugin_binaries",
    srcs = [
        "//emulator/plugin:goldfish_x86_64",
        "//emulator/plugin:goldfish_aarch64",
        # We currently don't have riscv images
        # "//emulator/plugin:goldfish_riscv64",
        "@rutabaga_gfx//:rutabaga_ffi",
    ] + select({
        "@platforms//os:linux": [
            # TODO(b/434942959,whollins): Re-add this.
            #"@gcc_lib//:libpulse",
        ],
        "//conditions:default": [
        ],
    }),
)

filegroup(
    name = "glib_binaries",
    srcs = [
        "@glib//glib:glib_shared",
        "@glib//gmodule:gmodule_shared",
    ],
)

all_binaries = [
    ":launcher_binaries",
    ":qemu_binaries",
    ":plugin_binaries",
    ":egl_binaries",
    ":vulkan_binaries",
    ":glib_binaries",
]

generate_notice_file(
    name = "emulator_notice_markdown",
    out = "notice.md",
    deps = all_binaries,
)

pkg_files(
    name = "emulator_notice_md",
    srcs = [":emulator_notice_markdown"],
)

stripped_binaries(
    name = "goldfish_binaries_stripped",
    srcs = all_binaries,
)

# Define pkg_files rules
pkg_files(
    # Note no prefix.
    name = "launcher",
    srcs = [":launcher_binaries"],
    attributes = pkg_attributes(
        mode = "0755",
    ),
    renames = select({
        "@platforms//os:windows": {
            "//emulator/launcher": "emulator.exe",
        },
        "//conditions:default": {
            "//emulator/launcher": "emulator",
        },
    }),
)

remapped_pkg_files(
    name = "launcher_stripped",
    src = ":launcher",
    transform = ":goldfish_binaries_stripped",
)

pkg_files(
    name = "qemu",
    srcs = [":qemu_binaries"],
    attributes = pkg_attributes(
        mode = "0755",
    ),
    # Where it should be in the final package
    prefix = "bin",
    renames = select({
        "@platforms//os:windows": {
            "@qemu//:qemu-system-x86_64": "qemu-system-x86_64.exe",
            "@qemu//:qemu-system-aarch64": "qemu-system-aarch64.exe",
            "@goldfish_prebuilts_common//netsim:netsim_windows_x86_64": "netsimd.exe",
            "@goldfish_prebuilts_common//netsim:netsim_cli_windows_x86_64": "netsim.exe",
        },
        "@platforms//os:macos": {
            # On Mac the Qemu binaries need to be signed and that extra steps results in a
            # different name for the binary. See here for details:
            # https://source.corp.google.com/h/googleplex-android/platform/superproject/main-emu-next-dev/+/main-emu-next-dev:external/qemu/platform/cc_interface_binary.bzl;l=101;drc=9e3171a3998e1fefddb5a024b0e0b5ffcc3f5576
            "@qemu//:qemu-system-x86_64_signed": "qemu-system-x86_64",
            "@qemu//:qemu-system-aarch64_signed": "qemu-system-aarch64",
            "@goldfish_prebuilts_common//netsim:netsim_darwin_aarch64": "netsimd",
            "@goldfish_prebuilts_common//netsim:netsim_cli_darwin_aarch64": "netsim",
        },
        "//conditions:default": {
            "@qemu//:qemu-system-x86_64": "qemu-system-x86_64",
            "@qemu//:qemu-system-aarch64": "qemu-system-aarch64",
            "@goldfish_prebuilts_common//netsim:netsim_linux_x86_64": "netsimd",
            "@goldfish_prebuilts_common//netsim:netsim_cli_linux_x86_64": "netsim",
            # We currently don't have riscv images
            # "@qemu//:qemu-system-riscv64": "qemu-system-riscv64",
        },
    }),
)

pkg_files(
    name = "security",
    srcs = select({
        "@platforms//os:macos": ["@qemu//:google/build/darwin-entitlements.plist"],
        "//conditions:default": [],
    }),
    attributes = pkg_attributes(
        mode = "0644",
    ),
    # Where it should be in the final package
    prefix = "_codesign",
    renames = select({
        "@platforms//os:macos": {
            "@qemu//:google/build/darwin-entitlements.plist": "entitlements.xml",
        },
        "//conditions:default": {
        },
    }),
)

remapped_pkg_files(
    name = "qemu_stripped",
    src = ":qemu",
    transform = ":goldfish_binaries_stripped",
)

pkg_files(
    name = "plugins",
    srcs = [":plugin_binaries"],
    prefix = "lib/qemu",
)

pkg_files(
    name = "egl",
    srcs = [":egl_binaries"],
    prefix = "lib64",
)

pkg_files(
    name = "vulkan",
    srcs = [":vulkan_binaries"],
    prefix = "lib64/vulkan",
)

pkg_files(
    name = "data_virtualscene_Toren1BD",
    srcs = ["@goldfish_prebuilts_common//virtualscene/Toren1BD"],
    prefix = "data/virtualscene/Toren1BD",
)

remapped_pkg_files(
    name = "egl_stripped",
    src = ":egl",
    transform = ":goldfish_binaries_stripped",
)

remapped_pkg_files(
    name = "vulkan_stripped",
    src = ":vulkan",
    transform = ":goldfish_binaries_stripped",
)

remapped_pkg_files(
    name = "plugins_stripped",
    src = ":plugins",
    transform = ":goldfish_binaries_stripped",
)

pkg_files(
    name = "emulator-access",
    srcs = ["//emulator/libs/grpc_security:emulator-access"],
    prefix = "lib",
)

pkg_files(
    name = "advanced_features",
    srcs = ["//emulator/launcher:advanced_features_ini"],
    prefix = "lib",
)

msvc_dlls_needed = [
    "msvcp140.dll",
    "vcruntime140.dll",
    "vcruntime140_1.dll",
]

[
    select_file(
        name = "msvc_" + dll,
        srcs = "@toolchain_hub//cc/windows_clang:msvc_dlls_x64",
        subpath = dll,
        target_compatible_with = ["@platforms//os:windows"],
    )
    for dll in msvc_dlls_needed
]

pkg_files(
    # Note no prefix. These must go in the same dir as emulator.exe.
    name = "win-dlls",
    srcs = ["msvc_" + dll for dll in msvc_dlls_needed],
    target_compatible_with = ["@platforms//os:windows"],
)

pkg_files(
    name = "glib_dlls",
    srcs = [":glib_binaries"],
    prefix = "lib64",
)

remapped_pkg_files(
    name = "glib_dlls_stripped",
    src = ":glib_dlls",
    transform = ":goldfish_binaries_stripped",
)

pkg_files(
    name = "qemu-keymaps",
    srcs = ["@qemu//:qemu-keymaps"],
    prefix = "share/qemu/keymaps",
)

pkg_files(
    name = "qemu-roms",
    srcs = ["@qemu//:qemu-roms"],
    prefix = "share/qemu",
)

# We have to exclude the fishtank and QtWebEngineProcess binaries as they have to be marked executable in a separate inclusion.
filter_directory(
    name = "fishtank_filtered_dir",
    src = "//emulator/launcher:fishtank_unzip",
    excludes = select({
        "@platforms//os:windows": [
            "fishtank/fishtank.exe",
            "fishtank/lib64/qt/bin/QtWebEngineProcess.exe",
        ],
        ":use_linux_internal_fishtank": [
            "fishtank/fishtank",
        ],
        "//conditions:default": [
            "fishtank/fishtank",
            "fishtank/lib64/qt/libexec/QtWebEngineProcess",
        ],
    }),
    outdir_name = "fishtank",
    strip_prefix = "fishtank",
)

pkg_files(
    name = "fishtank_dir",
    srcs = [":fishtank_filtered_dir"],
)

# We have to copy the fishtank binary first as the pkg_zip implementation doesn't like a symlink.
make_directory_path(
    name = "fishtank_binary_path",
    directory = "//emulator/launcher:fishtank_unzip",
    path = select({
        "@platforms//os:windows": "fishtank/fishtank.exe",
        "//conditions:default": "fishtank/fishtank",
    }),
)

copy_file(
    name = "fishtank_binary_copy",
    src = ":fishtank_binary_path",
    out = "fishtank_binary_copy_file",
)

pkg_files(
    name = "fishtank_binary",
    srcs = [":fishtank_binary_copy"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "fishtank",
    renames = select({
        "@platforms//os:windows": {
            ":fishtank_binary_copy": "fishtank.exe",
        },
        "//conditions:default": {
            ":fishtank_binary_copy": "fishtank",
        },
    }),
)

# We have to copy the QtWebEngineProcess binary first as the pkg_zip implementation doesn't like a symlink.
make_directory_path(
    name = "qtwebengine_binary_path",
    directory = "//emulator/launcher:fishtank_unzip",
    path = select({
        "@platforms//os:windows": "fishtank/lib64/qt/bin/QtWebEngineProcess.exe",
        "//conditions:default": "fishtank/lib64/qt/libexec/QtWebEngineProcess",
    }),
)

copy_file(
    name = "qtwebengine_binary_copy",
    src = ":qtwebengine_binary_path",
    out = "qtwebengine_binary_copy_file",
)

pkg_files(
    name = "qtwebengine_binary",
    srcs = [":qtwebengine_binary_copy"],
    attributes = pkg_attributes(mode = "0755"),
    prefix = select({
        "@platforms//os:windows": "fishtank/lib64/qt/bin",
        "//conditions:default": "fishtank/lib64/qt/libexec",
    }),
    renames = select({
        "@platforms//os:windows": {
            ":qtwebengine_binary_copy": "QtWebEngineProcess.exe",
        },
        "//conditions:default": {
            ":qtwebengine_binary_copy": "QtWebEngineProcess",
        },
    }),
)

pkg_filegroup(
    name = "emulator-dir",
    srcs = [
        ":advanced_features",
        ":data_virtualscene_Toren1BD",
        ":egl_stripped",
        ":emulator-access",
        ":emulator_notice_md",
        ":fishtank_binary",
        ":fishtank_dir",
        ":glib_dlls_stripped",
        ":launcher_stripped",
        ":plugins_stripped",
        ":qemu-keymaps",
        ":qemu-roms",
        ":qemu_stripped",
        ":source_properties_pkg",
        ":vulkan_stripped",
    ] + select({
        ":use_linux_internal_fishtank": [],
        "//conditions:default": [":qtwebengine_binary"],
    }) + select({
        "@platforms//os:windows": [
            ":win-dlls",
        ],
        "//conditions:default": [],
    }),
    prefix = "emulator",
)

pkg_filegroup(
    name = "emulator-dir-unstripped",
    srcs = [
        ":data_virtualscene_Toren1BD",
        ":egl",
        ":emulator-access",
        ":emulator_notice_md",
        ":glib_dlls",
        ":launcher",
        ":plugins",
        ":qemu",
        ":qemu-keymaps",
        ":qemu-roms",
        ":source_properties_pkg",
        ":vulkan",
    ] + select({
        "@platforms//os:windows": [
            ":win-dlls",
        ],
        "//conditions:default": [],
    }),
    prefix = "emulator",
)

pkg_zip(
    name = "release",
    srcs = [
        "emulator-dir",
        ":security",
    ],
    compression_level = select({
        ":is_developer_build": 1,
        "//conditions:default": 9,
    }),
    package_file_name = select({
        ":internal_fishtank_enabled": "G3-sdk-repo-{platform}-{product_name}-{build_id}.zip",
        "//conditions:default": "sdk-repo-{platform}-{product_name}-{build_id}.zip",
    }),
    package_variables = "//emulator/tools:aemu_version_info",
    tags = ["manual"],
)

internal_release(
    name = "release_internal",
    actual = ":release",
    tags = ["manual"],
)

pkg_zip(
    name = "release_unstripped",
    srcs = [
        "emulator-dir-unstripped",
        ":security",
    ],
    package_file_name = "UNSTRIPPED-sdk-repo-{platform}-{product_name}-{build_id}.zip",
    package_variables = "//emulator/tools:aemu_version_info",
    tags = ["manual"],
)

breakpad_symbols_pkg(
    name = "package_goldfish_symbols",
    binaries = all_binaries,
    ignore_paths_with_suffix = [
        "goldfish_prebuilts_common+/vulkan/windows-x86_64/vulkan-1.dll",
        "goldfish_prebuilts_common+/vulkan/windows-x86_64/icds/libvulkan_lvp.dll",
        "goldfish_prebuilts_common+/vulkan/windows-x86_64/icds/vk_swiftshader.dll",
    ],
    package_file_name = "sdk-repo-{platform}-{product_name}-breakpad-symbols-{build_id}.zip",
    package_variables = "//emulator/tools:aemu_version_info",
)

native_symbols_pkg(
    name = "package_goldfish_native_symbols",
    binaries = all_binaries,
    layout_templates = {
        "launcher": ":launcher",
        "qemu": ":qemu",
        "plugins": ":plugins",
        "egl": ":egl",
        "vulkan": ":vulkan",
        "glib": ":glib_dlls",
    },
    package_file_name = "sdk-repo-{platform}-{product_name}-native-symbols-{build_id}.zip",
    package_variables = "//emulator/tools:aemu_version_info",
)

build_test(
    name = "release_build_test",
    tags = ["manual"],
    targets = [":release"],
)

test_suite(
    # This contains all unit tests from external packages and dependencies
    # These are not run by default.
    name = "external_unit_tests",
    tags = ["manual"],
    tests = [
        "@boringssl//:crypto_test",
        "@boringssl//:decrepit_test",
        "@boringssl//:pki_test",
        "@boringssl//:ssl_test",
        "@boringssl//:urandom_test",
        "@crashpad//:crashpad_tests",
        "@ffmpeg//:tests",
        "@libsrtp2//:test_srtp",
        "@libyuv//:libyuv_unittest",
    ],
)
