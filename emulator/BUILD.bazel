load("@//build/bazel/rules/native:native_binaries.bzl", "stripped_binaries")
load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_license//rules:license_kind.bzl", "license_kind")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:zip.bzl", "pkg_zip")
load("@rules_python//python:defs.bzl", "py_binary")
load(
    ":packaging.bzl",
    "aemu_naming",
    "breakpad_symbols_pkg",
    "build_id_from_command_line",
    "native_symbols_pkg",
    "remapped_pkg_files",
)

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

config_setting(
    name = "dbg",
    values = {"compilation_mode": "dbg"},
)

config_setting(
    name = "opt",
    values = {"compilation_mode": "opt"},
)

license(
    name = "license",
    license_kinds = [
        ":SPDX-license-identifier-Apache-2.0",
    ],
    visibility = [":__subpackages__"],
)

license_kind(
    name = "SPDX-license-identifier-Apache-2.0",
    conditions = ["notice"],
    url = "https://spdx.org/licenses/Apache-2.0.html",
)

# You can pass in the build id from the bazel command line flag
# as follows:
# --//hardware/generic/goldfish/emulator:build_id=P123
build_id_from_command_line(
    name = "build_id",
    build_setting_default = "developer",
)

py_binary(
    name = "symbol_zipper",
    srcs = ["symbol_zipper.py"],
)

aemu_naming(
    name = "aemu_version_info",
    build_id_dep = ":build_id",
    platform = select({
        "@platforms//os:windows": "windows",
        "@platforms//os:macos": "darwin_aarch64",
        "@platforms//os:linux": "linux",
        "//conditions:default": "unknown",
    }),
    product_name = select({
        "//conditions:default": "",
        ":dbg": "emulator-debug",
        ":opt": "emulator",
    }),
)

launcher_binaries = [
    "//hardware/generic/goldfish/emulator/launcher:goldfish",
]

crashreporting_binaries = [
    "@com_google_crashpad//handler:crashpad_handler",
    "//hardware/generic/goldfish/emulator/crashreport",
]

qemu_binaries = [
    "//third_party/qemu:qemu-img",
    "//third_party/qemu:qemu-system-x86_64",
    "//hardware/generic/goldfish/third_party/sparse:img2simg",
] + select({
    "@platforms//os:windows": [],
    "//conditions:default": [
        "//third_party/qemu:qemu-system-aarch64",
        # We currently don't have riscv images
        # "//third_party/qemu:qemu-system-riscv64",
    ],
})

plugin_binaries = [
    "//hardware/generic/goldfish/emulator/plugin:goldfish_x86_64",
    "@crosvm//:rutabaga_ffi",
] + select({
    "@platforms//os:windows": [],
    "//conditions:default": [
        "//hardware/generic/goldfish/emulator/plugin:goldfish_aarch64",
        # We currently don't have riscv images
        # "//hardware/generic/goldfish/emulator/plugin:goldfish_riscv64",
    ],
}) + select({
    "@platforms//os:linux": [
        # TODO(b/434942959,whollins): Re-add this.
        #"@gcc_lib//:libpulse",
    ],
    "//conditions:default": [
    ],
})

all_binaries = launcher_binaries + qemu_binaries + plugin_binaries + crashreporting_binaries

stripped_binaries(
    name = "goldfish_binaries_stripped",
    srcs = all_binaries,
)

# Define pkg_files rules
pkg_files(
    name = "launcher",
    srcs = launcher_binaries,
    attributes = pkg_attributes(
        mode = "0755",
    ),
)

remapped_pkg_files(
    name = "launcher_stripped",
    src = ":launcher",
    transform = ":goldfish_binaries_stripped",
)

pkg_files(
    name = "qemu-binaries",
    srcs = qemu_binaries + crashreporting_binaries,
    attributes = pkg_attributes(
        mode = "0755",
    ),
    # Where it should be in the final package
    prefix = "bin",
    renames = select({
        "@platforms//os:windows": {
            "//third_party/qemu:qemu-system-x86_64_std": "qemu-system-x86_64.exe",
        },
        "//conditions:default": {
            "//third_party/qemu:qemu-system-x86_64": "qemu-system-x86_64",
            "//third_party/qemu:qemu-system-aarch64": "qemu-system-aarch64",
            # We currently don't have riscv images
            # "//third_party/qemu:qemu-system-riscv64": "qemu-system-riscv64",
        },
    }),
)

remapped_pkg_files(
    name = "qemu-binaries_stripped",
    src = ":qemu-binaries",
    transform = ":goldfish_binaries_stripped",
)

pkg_files(
    name = "plugins",
    srcs = plugin_binaries,
    prefix = "lib/qemu/",
)

pkg_files(
    name = "data_virtualscene_Toren1BD",
    srcs = [
        "//prebuilts/android-emulator-build/common/virtualscene/Toren1BD",
    ],
    prefix = "data/virtualscene/Toren1BD/",
)

remapped_pkg_files(
    name = "plugins_stripped",
    src = ":plugins",
    transform = ":goldfish_binaries_stripped",
)

pkg_zip(
    name = "release",
    srcs = [
        ":data_virtualscene_Toren1BD",
        ":launcher_stripped",
        ":plugins_stripped",
        ":qemu-binaries_stripped",
        "//hardware/generic/goldfish/emulator/grpc/security:emulator-access",
        "//third_party/qemu:qemu-keymaps",
        "//third_party/qemu:qemu-roms",
    ],
    package_file_name = "sdk-repo-{platform}-{product_name}-{build_id}.zip",
    package_variables =
        ":aemu_version_info",
)

filegroup(
    name = "goldfish_binaries",
    srcs = all_binaries,
)

breakpad_symbols_pkg(
    name = "package_goldfish_symbols",
    binaries = all_binaries,
    package_file_name = "sdk-repo-{platform}-{product_name}-breakpad-symbols-{build_id}.zip",
    package_variables = ":aemu_version_info",
)

native_symbols_pkg(
    name = "package_goldfish_native_symbols",
    binaries = all_binaries,
    layout_templates = {
        "launcher": ":launcher",
        "qemu": ":qemu-binaries",
        "plugins": ":plugins",
    },
    package_file_name = "sdk-repo-{platform}-{product_name}-native-symbols-{build_id}.zip",
    package_variables = ":aemu_version_info",
)

build_test(
    name = "release_build_test",
    targets = [":release"],
)

test_suite(
    # This contains all unit tests from external packages and dependencies
    # These are not run by default.
    name = "external_unit_tests",
    tags = ["manual"],
    tests = [
        "@boringssl//:crypto_test",
        "@boringssl//:decrepit_test",
        "@boringssl//:pki_test",
        "@boringssl//:ssl_test",
        "@boringssl//:urandom_test",
        "@com_google_crashpad//:crashpad_tests",
        "@libyuv//:libyuv_unittest",
        "@pffft//:pffft_test",
    ],
)

test_suite(
    name = "emulator_unit_tests",
    tests = [
        "//hardware/generic/goldfish/android:emulator_android_tests",
        "//hardware/generic/goldfish/android/async:eventloop_unittests",
        "//hardware/generic/goldfish/android/async:sockets_unittests",
        "//hardware/generic/goldfish/emulator/adb/host:host_unitests",
        "//hardware/generic/goldfish/emulator/adb/logger:logger_unitests",
        "//hardware/generic/goldfish/emulator/cmdline:cmdline_unittests",
        "//hardware/generic/goldfish/emulator/config:config_unittests",
        "//hardware/generic/goldfish/emulator/crashreport:crashreport_test",
        "//hardware/generic/goldfish/emulator/grpc:grpc-unit-tests",
        "//hardware/generic/goldfish/emulator/grpc/absl:translate_test",
        "//hardware/generic/goldfish/emulator/grpc/services/emulator_controller/input:input_unittests",
        "//hardware/generic/goldfish/emulator/grpc/services/emulator_controller/server:emulator-service_unittests",
        "//hardware/generic/goldfish/emulator/hal:hal_unittests",
        "//hardware/generic/goldfish/emulator/hal/bootproperties:bootproperties_unittests",
        "//hardware/generic/goldfish/emulator/hal/camera:camera_unittests",
        "//hardware/generic/goldfish/emulator/hal/clipboard:clipboard_unittests",
        "//hardware/generic/goldfish/emulator/hal/display:display_unittests",
        "//hardware/generic/goldfish/emulator/hal/gps:gps_unittests",
        "//hardware/generic/goldfish/emulator/hal/guest-status:guest-status_unittests",
        "//hardware/generic/goldfish/emulator/hal/sensors:sensors_unittests",
        "//hardware/generic/goldfish/emulator/hal/vminterface:vminterface_unittests",
        "//hardware/generic/goldfish/emulator/launcher:launcher_unittests",
        "//hardware/generic/goldfish/emulator/libs:libs_unittests",
    ],
)
