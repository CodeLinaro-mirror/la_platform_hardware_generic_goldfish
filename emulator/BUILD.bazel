load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("@rules_license//rules:license.bzl", "license")
load("@rules_license//rules:license_kind.bzl", "license_kind")
load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:zip.bzl", "pkg_zip")
load(":release_package_name.bzl", "aemu_naming", "build_id_from_command_line")
load(":symbol_extraction.bzl", "breakpad_symbols_pkg", "package_windows_pdbs")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

config_setting(
    name = "dbg",
    values = {"compilation_mode": "dbg"},
)

config_setting(
    name = "opt",
    values = {"compilation_mode": "opt"},
)

license(
    name = "license",
    license_kinds = [
        ":SPDX-license-identifier-Apache-2.0",
    ],
    visibility = [":__subpackages__"],
)

license_kind(
    name = "SPDX-license-identifier-Apache-2.0",
    conditions = ["notice"],
    url = "https://spdx.org/licenses/Apache-2.0.html",
)

# You can pass in the build id from the bazel command line flag
# as follows:
# --//hardware/generic/goldfish/emulator:build_id=P123
build_id_from_command_line(
    name = "build_id",
    build_setting_default = "developer",
)

aemu_naming(
    name = "aemu_version_info",
    build_id_dep = ":build_id",
    platform = select({
        "@platforms//os:windows": "windows",
        "@platforms//os:macos": "darwin_aarch64",
        "@platforms//os:linux": "linux",
        "//conditions:default": "unknown",
    }),
    product_name = select({
        "//conditions:default": "",
        ":dbg": "emulator-debug",
        ":opt": "emulator",
    }),
)

launcher_binaries = [
    "//hardware/generic/goldfish/emulator/launcher:goldfish",
]

crashreporting_binaries = [
    "@com_google_crashpad//handler:crashpad_handler",
    "//hardware/generic/goldfish/emulator/crashreport",
]

qemu_binaries = [
    "//external/qemu:qemu-img",
    "//external/qemu:qemu-system-x86_64",
    "//hardware/generic/goldfish/third_party/sparse:img2simg",
] + select({
    "@platforms//os:windows": [],
    "//conditions:default": [
        "//external/qemu:qemu-system-aarch64",
        "//external/qemu:qemu-system-riscv64",
    ],
})

plugin_binaries = [
    "//external/qemu:hw-display-virtio-gpu",
    "//external/qemu:hw-display-virtio-gpu-pci",
    "//external/qemu:hw-display-virtio-vga",
    "//external/qemu:hw-display-virtio-vga-gl",
    "//hardware/generic/goldfish/emulator/plugin/avd",
    "//hardware/generic/goldfish/emulator/plugin/vsock_goldfish:virtio-vsock-goldfish-aarch64",
    "//hardware/generic/goldfish/emulator/plugin/vsock_goldfish:virtio-vsock-goldfish-riscv64",
    "//hardware/generic/goldfish/emulator/plugin/vsock_goldfish:virtio-vsock-goldfish-x86_64",
] + select({
    "@platforms//os:windows": [],
    "@platforms//os:macos": [
        "//external/crosvm/rutabaga_gfx/ffi:rutabaga_ffi",
        "//external/qemu:hw-display-virtio-gpu-pci-rutabaga",
        "//external/qemu:hw-display-virtio-gpu-rutabaga",
        "//hardware/generic/goldfish/emulator/plugin/grpc",
    ],
    "@platforms//os:linux": [
        "//external/crosvm/rutabaga_gfx/ffi:rutabaga_ffi",
        "//external/qemu:accel-tcg-x86_64",
        "//external/qemu:audio-pa",
        "//external/qemu:hw-display-virtio-gpu-pci-rutabaga",
        "//external/qemu:hw-display-virtio-gpu-rutabaga",
        "//hardware/generic/goldfish/emulator/plugin/grpc",
    ],
    "//conditions:default": [],
})

all_binaries = launcher_binaries + qemu_binaries + plugin_binaries + crashreporting_binaries

# Define pkg_files rules
pkg_files(
    name = "launcher",
    srcs = launcher_binaries,
    attributes = pkg_attributes(
        mode = "0755",
    ),
)

pkg_files(
    name = "qemu-binaries",
    srcs = qemu_binaries + crashreporting_binaries,
    attributes = pkg_attributes(
        mode = "0755",
    ),
    # Where it should be in the final package
    prefix = "bin",
    renames = select({
        "@platforms//os:windows": {
            "//external/qemu:qemu-system-x86_64_std": "qemu-system-x86_64.exe",
        },
        "//conditions:default": {
            "//external/qemu:qemu-system-x86_64": "qemu-system-x86_64",
            "//external/qemu:qemu-system-aarch64": "qemu-system-aarch64",
            "//external/qemu:qemu-system-riscv64": "qemu-system-riscv64",
        },
    }),
)

pkg_files(
    name = "plugins",
    srcs = plugin_binaries,
    prefix = "lib/qemu/",
)

pkg_zip(
    name = "release",
    srcs = [
        ":launcher",
        ":plugins",
        ":qemu-binaries",
        "//external/qemu:qemu-keymaps",
        "//external/qemu:qemu-roms",
        "//hardware/generic/goldfish/emulator/android-grpc/security:emulator-access",
    ],
    package_file_name = "sdk-repo-{platform}-{product_name}-{build_id}.zip",
    package_variables =
        ":aemu_version_info",
)

filegroup(
    name = "goldfish_binaries",
    srcs = all_binaries,
)

breakpad_symbols_pkg(
    name = "package_goldfish_symbols",
    binaries = all_binaries,
    package_file_name = "sdk-repo-{platform}-{product_name}-breakpad-symbols-{build_id}.zip",
    package_variables = ":aemu_version_info",
)

package_windows_pdbs(
    name = "package_goldfish_pdbs",
    binaries = all_binaries,
    package_file_name = "sdk-repo-{platform}-{product_name}-pdbs-{build_id}.zip",
    package_variables = ":aemu_version_info",
)

build_test(
    name = "release_build_test",
    targets = [":release"],
)

