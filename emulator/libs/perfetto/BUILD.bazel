load("@goldfish_build//rules:clang_tidy.bzl", "clang_tidy_test")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "init",
    srcs = select({
        "@qemu//:goldfish_enabled": ["perfetto_config.cc"],
        "//conditions:default": [],
    }),
    hdrs = [
        "include/goldfish/perfetto/perfetto.h",
        "include/goldfish/perfetto/perfetto_categories.h",
    ],
    defines = select({
        "@qemu//:goldfish_enabled": ["CONFIG_TRACE_GOLDFISH"],
        "//conditions:default": [],
    }),
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = select({
        "@qemu//:goldfish_enabled": [
            "@abseil-cpp//absl/strings",
            "@perfetto//:libperfetto_client_experimental",
        ],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "qemu_trace_bridge",
    srcs = select({
        "@qemu//:goldfish_enabled": ["qemu_trace_bridge.cc"],
        "//conditions:default": [],
    }),
    hdrs = [
        "include/goldfish/perfetto/qemu_trace_bridge.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        ":init",
        "@abseil-cpp//absl/strings",
        "@qemu//:qemu-headers-exported",
    ],
)

cc_test(
    name = "init_test",
    size = "small",
    srcs = select({
        "@qemu//:goldfish_enabled": ["perfetto_config_test.cc"],
        "//conditions:default": [],
    }),
    deps = [
        ":init",
        ":qemu_trace_bridge",
        "//emulator/libs/system:test-headers",
        "//emulator/libs/test:googletest_main",
    ],
)

clang_tidy_test(
    name = "tidy",
    targets = [
        ":init",
        ":init_test",
    ],
    tidy_config_file = "//:clang_tidy_config",
)
