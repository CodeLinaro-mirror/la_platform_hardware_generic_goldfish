load("@goldfish_build//rules:clang_tidy.bzl", "clang_tidy_test")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "adbkey",
    srcs = ["adbkey.cc"],
    hdrs = ["include/goldfish/adb/adbkey.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//emulator/libs/system",
        "@abseil-cpp//absl/log",
        "@boringssl//:ssl",
    ],
)

cc_test(
    name = "adbkey_test",
    srcs = ["adbkey_test.cc"],
    visibility = ["//visibility:public"],
    deps = [
        ":adbkey",
        "//emulator/libs/system:test-headers",
        "//emulator/libs/test:googletest_main",
    ],
)

clang_tidy_test(
    name = "tidy",
    targets = [
        "adbkey_test",
        "adbkey",
    ],
    tidy_config_file = "//:clang_tidy_config",
)
