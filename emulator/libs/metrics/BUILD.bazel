# This is needed when compiling google_logs_response_cc_proto on Windows.
# Unfortunately cxxopts = ["-Wno-invalid-offsetof"] can't be used on cc_proto_library
# and this is better than disabling that warning in the toolchain.
package(features = ["-warnings_as_errors"])

clang_tidy_test(
    name = "tidy",
    targets = [
        # TODO(whollins): Figure out why these don't work.
        #":metrics_uuid",
        #":metrics_reporter",
        #":text_metrics_writer",
    ],
    tidy_config_file = "//:clang_tidy_config",
)

cc_library(
    name = "metrics_uuid",
    srcs = ["uuid.cc"],
    hdrs = ["include/goldfish/metrics/uuid.h"],
    includes = ["include"],
    linkopts = select({
        "@platforms//os:windows": [
            "-DEFAULTLIB:Rpcrt4.lib",
        ],
        "//conditions:default": [],
    }),
    deps = [
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
    ] + select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@libuuid"],
    }),
)

cc_test(
    name = "uuid_test",
    size = "small",
    srcs = ["uuid_test.cc"],
    deps = [
