load("@aemu//tools/clang_tidy:defs.bzl", "clang_tidy_test")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//emulator/tools:cc_binary_with_manifest.bzl", "cc_binary_with_manifest")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "absl_translate",
    srcs = ["absl_status_translate.cc"],
    hdrs = [
        "include/android/emulation/control/absl_status_translate.h",
        "include/android/emulation/control/screen_recording_constants.h",
    ],
    includes = ["include"],
    deps = [
        "@abseil-cpp//absl/status",
        "@grpc//:grpc++",
    ],
)

cc_test(
    name = "absl_translate_test",
    size = "small",
    srcs = ["absl_status_translate_test.cc"],
    deps = [
        ":absl_translate",
        "//emulator/libs/test:googletest_main",
        "@googletest//:gtest",
    ],
)

cc_library(
    name = "async",
    hdrs = [
        "include/android/emulation/control/enum_translate.h",
        "include/android/emulation/control/generic_callback_functions.h",
        "include/android/emulation/control/library.h",
        "include/android/emulation/control/simple_async_grpc.h",
        "include/android/emulation/control/sync_to_async_adapter.h",
    ],
    includes = ["include"],
    deps = ["@grpc//:grpc++"],
)

cc_test(
    name = "async_test",
    size = "small",
    srcs = [
        "async_test.cc",
        "simple_async_grpc_test.cc",
    ],
    deps = [
        ":async",
        ":event-stream",
        "//emulator/libs/test:googletest_main",
        "@aemu//protos/services/emulator-controller:emulator_controller_cc_grpc",
        "@googletest//:gtest",
    ],
)

cc_library(
    name = "event-stream",
    hdrs = ["include/android/emulation/control/grpc_event_stream_support.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        ":async",
        "//emulator/libs/eventing",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/synchronization",
        "@grpc//:grpc++",
    ],
)

cc_binary_with_manifest(
    name = "async_perf",
    testonly = True,
    srcs = ["simple_async_grpc_perf.cc"],
    deps = [
        ":async",
        "@google_benchmark//:benchmark_main",
    ],
)

clang_tidy_test(
    name = "tidy",
    targets = [
        ":absl_translate",
        ":absl_translate_test",
        ":async",
        ":async_perf",
        ":async_test",
        ":event-stream",
    ],
    tidy_config_file = "//:clang_tidy_config",
)
