load("@goldfish_build//rules:clang_tidy.bzl", "clang_tidy_test")
load("@goldfish_build//rules:windows_resources.bzl", "windows_manifest_resource")
load("@rules_cc//cc:defs.bzl", "cc_library")

windows_manifest_resource(
    name = "googletest_main_manifest_rc",
    testonly = True,
    binary_filename = "googletest_main.exe",
    target_compatible_with = ["@platforms//os:windows"],
)

cc_library(
    name = "googletest_main",
    testonly = True,
    srcs = ["gtest_main.cc"],
    data = [
        "leak_suppressions.txt",
    ],
    implementation_deps = [
        "//emulator/libs/system",
        "//emulator/libs/system:bazel_info",
    ],
    # Linked into the test binary so its sanitizer hooks (e.g.
    # __tsan_default_suppressions) override the runtime's weak defaults.
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/debugging:failure_signal_handler",
        "@abseil-cpp//absl/debugging:symbolize",
        "@abseil-cpp//absl/flags:flag",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/log:flags",
        "@abseil-cpp//absl/log:initialize",
        "@googletest//:gtest",
    ] + select({
        "@platforms//os:windows": [":googletest_main_manifest_rc"],
        "//conditions:default": [],
    }),
    alwayslink = True,
)

clang_tidy_test(
    name = "tidy",
    targets = [
        ":googletest_main",
    ],
    tidy_config_file = "//:clang_tidy_config",
)
