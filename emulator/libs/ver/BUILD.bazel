load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test", "objc_library")
load("//emulator/tools:plugins.bzl", "collect_plugins")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

exports_files(["ver_testdata.BUILD"])

selects.config_setting_group(
    name = "darwin_aarch64",
    match_all = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

objc_library(
    name = "webcam_source_darwin",
    srcs = [
        "src/VerLogging.h",
        "src/raw_image_sources/fourcc_utils.h",
        "src/raw_image_sources/raw_image_source.h",
        "src/raw_image_sources/webcam/webcam_source.h",
    ],
    hdrs = [
        "include/ver/export.h",
        "include/ver/virtual_environment_renderer_types.h",
    ],
    copts = ["-std=c++20"],
    includes = [
        "include",
        "src",
        "src/raw_image_sources",
        "src/raw_image_sources/webcam",
    ],
    non_arc_srcs = [
        "src/raw_image_sources/webcam/webcam_source_mac.mm",
    ],
    sdk_frameworks = [
        "AVFoundation",
        "Accelerate",
        "CoreMedia",
        "CoreVideo",
    ],
    target_compatible_with = [
        "@platforms//os:macos",
    ],
    deps = [
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/types:optional",
        "@aemu//base:aemu-base-headers",
        "@gfxstream//third_party/glm",
    ],
    alwayslink = True,
)

cc_library(
    name = "raw_video_file_source",
    srcs = [
        "src/VerLogging.h",
        "src/raw_image_sources/raw_image_source.h",
        "src/raw_image_sources/video_file/raw_video_file_source.cc",
    ],
    hdrs = [
        "include/ver/export.h",
        "include/ver/virtual_environment_renderer_types.h",
        "src/raw_image_sources/video_file/raw_video_file_source.h",
    ],
    implementation_deps = [
        "@ffmpeg//libavcodec:avcodec",
        "@ffmpeg//libavformat:avformat",
        "@ffmpeg//libavutil:avutil",
        "@ffmpeg//libswscale:swscale",
    ],
    includes = [
        "include",
        "src",
    ],
    visibility = ["//visibility:private"],
    deps = [
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings:str_format",
        "@aemu//base:aemu-base-headers",
        "@gfxstream//third_party/glm",
    ],
)

cc_library(
    name = "ver",
    srcs = [
        "src/JpegUtils.cpp",
        "src/MeshSceneObject.cpp",
        "src/PosterSceneObject.cpp",
        "src/Renderer.cpp",
        "src/RendererVulkan.cpp",
        "src/Scene.cpp",
        "src/SceneObject.cpp",
        "src/StreetViewUtils.cpp",
        "src/TextureUtils.cpp",
        "src/raw_image_sources/fourcc_utils.cc",
        "src/raw_image_sources/image_file/raw_image_file_source.cc",
        "src/raw_image_sources/raw_image_source.cc",
        "src/raw_image_sources/webcam/webcam_source.cc",
        "src/raw_image_sources/webcam/webcam_source_virtual.cc",
        "src/virtual_environment_renderer.cpp",
    ] + select({
        "@platforms//os:linux": ["src/raw_image_sources/webcam/webcam_source_linux.cc"],
        "@platforms//os:windows": ["src/raw_image_sources/webcam/webcam_source_windows.cc"],
        "//conditions:default": [],
    }),
    hdrs = [
        "include/ver/export.h",
        "include/ver/virtual_environment_renderer.h",
        "include/ver/virtual_environment_renderer_types.h",
        "src/JpegUtils.h",
        "src/MeshSceneObject.h",
        "src/PosterSceneObject.h",
        "src/Renderer.h",
        "src/RendererVulkan.h",
        "src/Scene.h",
        "src/SceneObject.h",
        "src/ScenesManager.h",
        "src/StreetViewUtils.h",
        "src/TextureUtils.h",
        "src/VerLogging.h",
        "src/VertexTypes.h",
        "src/VulkanShaders.h",
        "src/raw_image_sources/fourcc_utils.h",
        "src/raw_image_sources/image_file/raw_image_file_source.h",
        "src/raw_image_sources/raw_image_source.h",
        "src/raw_image_sources/webcam/webcam_source.h",
        "src/raw_image_sources/webcam/webcam_source_virtual.h",
    ],
    copts = [
        "-Wno-unused-function",
    ] + select({
        # @curl 8.12.0 exports "lib" in its include path, which contains an
        # internal "share.h" that shadows the Windows UCRT <share.h> included by
        # MSVC STL headers (<xiosbase>, <fstream>) and pulls in "curl_setup.h"
        # (redefining fopen to curlx_win32_fopen with C++ linkage).
        "@platforms//os:windows": [
            "/FIcorecrt_share.h",
            "/DHEADER_CURL_SHARE_H",
        ],
        "//conditions:default": [],
    }),
    defines = [
        "GLM_ENABLE_EXPERIMENTAL",
        "GLM_FORCE_CXX14",
        "GLM_FORCE_RADIANS",
        "VER_STATIC_DEFINE",
    ],
    implementation_deps = [
        "@curl",
    ],
    includes = [
        "include",
        "src",
    ],
    linkopts = select({
        "@platforms//os:windows": [
            "-DEFAULTLIB:mfplat.lib",
            "-DEFAULTLIB:mfuuid.lib",
            "-DEFAULTLIB:ole32.lib",
            "-DEFAULTLIB:strmiids.lib",
            "-DEFAULTLIB:uuid.lib",
        ],
        "//conditions:default": [],
    }),
    linkstatic = True,
    deps = [
        ":raw_video_file_source",
        "//emulator/libs/gvk",
        "//emulator/libs/system",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/types:optional",
        "@aemu//base:aemu-base-headers",
        "@gfxstream//third_party/glm",
        "@libjpeg_turbo//:jpeg",
        "@libpng//:png",
        "@libyuv",
        "@nlohmann_json//:json",
        "@tinygltf",
        "@tinyobjloader",
        "@vulkan-headers//:vulkan_headers",
    ] + select({
        "@platforms//os:macos": [":webcam_source_darwin"],
        "//conditions:default": [],
    }),
    alwayslink = True,
)

collect_plugins(
    name = "test_vulkan_icds",
    output_dir = "lib64/vulkan",
    plugins = select({
        ":darwin_aarch64": [
            "@goldfish_prebuilts_common//vulkan:icds_darwin_aarch64",
            "@goldfish_prebuilts_common//vulkan:lib_darwin_aarch64",
            "@mesa3d//:generate_lvp_icd",
            "@mesa3d//:vulkan_lvp",
        ],
        "@goldfish_build//platforms:is_linux_aarch64": [],
        "@platforms//os:linux": [
            "@goldfish_prebuilts_common//vulkan:icds_linux_x86_64",
            "@goldfish_prebuilts_common//vulkan:lib_linux_x86_64",
            "@llvm-project//llvm:libLLVM.so",
            "@mesa3d//:vulkan_lvp",
            "@mesa3d//:generate_lvp_icd",
        ],
        "@platforms//os:windows": [
            "@goldfish_prebuilts_common//vulkan:icds_windows_x86_64",
            "@goldfish_prebuilts_common//vulkan:lib_windows_x86_64",
        ],
        "//conditions:default": [],
    }),
)

collect_plugins(
    name = "test_resources",
    output_dir = "resources",
    plugins = [
        "@goldfish_prebuilts_common//virtualscene",
    ],
)

collect_plugins(
    name = "test_testdata",
    output_dir = "testdata",
    plugins = [
        "@ver_testdata//:testdata_flat",
    ],
)

collect_plugins(
    name = "test_testdata_exif",
    output_dir = "testdata/ver/exif_rotation",
    plugins = [
        "@ver_testdata//:testdata_exif_rotation",
    ],
)

cc_test(
    name = "ver_unittests",
    size = "medium",
    srcs = [
        "test/JpegUtils_unittest.cpp",
        "test/RawImageFileSource_unittest.cpp",
        "test/SceneRenderingGltf_unittests.cpp",
        "test/SceneRendering_unittests.cpp",
        "test/TestUtils.h",
        "test/TextureUtils_unittest.cpp",
        "test/WebcamSource_unittest.cpp",
    ],
    copts = [
        "-DGLM_ENABLE_EXPERIMENTAL",
        "-DGLM_FORCE_RADIANS",
    ],
    data = [
        ":test_resources",
        ":test_testdata",
        ":test_testdata_exif",
        ":test_vulkan_icds",
    ],
    env = {
        "LD_LIBRARY_PATH": "emulator/libs/ver/lib64/vulkan",
    },
    # TODO(b/568399159): Intentionally skipped on Windows.
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":ver",
        "//emulator/libs/system",
        "//emulator/libs/system:bazel_info",
        "//emulator/libs/test:googletest_main",
        "@aemu//base:aemu-base-headers",
        "@gfxstream//third_party/glm",
        "@libjpeg_turbo//:jpeg",
        "@libpng//:png",
    ],
)
