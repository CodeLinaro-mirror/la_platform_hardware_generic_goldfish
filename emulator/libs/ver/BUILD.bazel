load("@rules_cc//cc:defs.bzl", "cc_library", "objc_library")

package(
    default_visibility = ["//visibility:public"],
    licenses = ["notice"],
)

objc_library(
    name = "webcam_source_darwin",
    srcs = [
        "src/VerLogging.h",
        "src/raw_image_sources/fourcc_utils.h",
        "src/raw_image_sources/raw_image_source.h",
        "src/raw_image_sources/webcam/webcam_source.h",
    ],
    hdrs = [
        "include/ver/export.h",
        "include/ver/virtual_environment_renderer_types.h",
    ],
    copts = ["-std=c++20"],
    includes = [
        "include",
        "src",
        "src/raw_image_sources",
        "src/raw_image_sources/webcam",
    ],
    non_arc_srcs = [
        "src/raw_image_sources/webcam/webcam_source_mac.mm",
    ],
    sdk_frameworks = [
        "AVFoundation",
        "Accelerate",
        "CoreMedia",
        "CoreVideo",
    ],
    target_compatible_with = [
        "@platforms//os:macos",
    ],
    deps = [
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/types:optional",
        "@aemu//base:aemu-base-headers",
        "@gfxstream//third_party/glm",
    ],
    alwayslink = True,
)

cc_library(
    name = "raw_video_file_source",
    srcs = [
        "src/VerLogging.h",
        "src/raw_image_sources/raw_image_source.h",
        "src/raw_image_sources/video_file/raw_video_file_source.cc",
    ],
    hdrs = [
        "include/ver/export.h",
        "include/ver/virtual_environment_renderer_types.h",
        "src/raw_image_sources/video_file/raw_video_file_source.h",
    ],
    implementation_deps = [
        "@ffmpeg//libavcodec:avcodec",
        "@ffmpeg//libavformat:avformat",
        "@ffmpeg//libavutil:avutil",
        "@ffmpeg//libswscale:swscale",
    ],
    includes = [
        "include",
        "src",
    ],
    visibility = ["//visibility:private"],
    deps = [
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings:str_format",
        "@aemu//base:aemu-base-headers",
        "@gfxstream//third_party/glm",
    ],
)

cc_library(
    name = "ver",
    srcs = [
        "src/JpegUtils.cpp",
        "src/JpegUtils.h",
        "src/MeshSceneObject.cpp",
        "src/MeshSceneObject.h",
        "src/PosterSceneObject.cpp",
        "src/PosterSceneObject.h",
        "src/Renderer.cpp",
        "src/Renderer.h",
        "src/RendererVulkan.cpp",
        "src/RendererVulkan.h",
        "src/Scene.cpp",
        "src/Scene.h",
        "src/SceneObject.cpp",
        "src/SceneObject.h",
        "src/ScenesManager.h",
        "src/StreetViewUtils.cpp",
        "src/StreetViewUtils.h",
        "src/TextureUtils.cpp",
        "src/TextureUtils.h",
        "src/VerLogging.h",
        "src/VertexTypes.h",
        "src/VulkanShaders.h",
        "src/raw_image_sources/fourcc_utils.cc",
        "src/raw_image_sources/fourcc_utils.h",
        "src/raw_image_sources/image_file/raw_image_file_source.cc",
        "src/raw_image_sources/image_file/raw_image_file_source.h",
        "src/raw_image_sources/raw_image_source.cc",
        "src/raw_image_sources/raw_image_source.h",
        "src/raw_image_sources/webcam/webcam_source.cc",
        "src/raw_image_sources/webcam/webcam_source.h",
        "src/raw_image_sources/webcam/webcam_source_virtual.cc",
        "src/raw_image_sources/webcam/webcam_source_virtual.h",
        "src/virtual_environment_renderer.cpp",
    ] + select({
        "@platforms//os:linux": ["src/raw_image_sources/webcam/webcam_source_linux.cc"],
        "@platforms//os:windows": ["src/raw_image_sources/webcam/webcam_source_windows.cc"],
        "//conditions:default": [],
    }),
    hdrs = [
        "include/ver/export.h",
        "include/ver/virtual_environment_renderer.h",
        "include/ver/virtual_environment_renderer_types.h",
    ],
    copts = [
        "-Wno-unused-function",
    ] + select({
        # @curl 8.12.0 exports "lib" in its include path, which contains an
        # internal "share.h" that shadows the Windows UCRT <share.h> included by
        # MSVC STL headers (<xiosbase>, <fstream>) and pulls in "curl_setup.h"
        # (redefining fopen to curlx_win32_fopen with C++ linkage).
        "@platforms//os:windows": [
            "/FIcorecrt_share.h",
            "/DHEADER_CURL_SHARE_H",
        ],
        "//conditions:default": [],
    }),
    defines = [
        "GLM_ENABLE_EXPERIMENTAL",
        "GLM_FORCE_CXX14",
        "GLM_FORCE_RADIANS",
        "VER_STATIC_DEFINE",
    ],
    implementation_deps = [
        "@curl",
    ],
    includes = [
        "include",
        "src",
    ],
    linkopts = select({
        "@platforms//os:windows": [
            "-DEFAULTLIB:mfplat.lib",
            "-DEFAULTLIB:mfuuid.lib",
            "-DEFAULTLIB:ole32.lib",
            "-DEFAULTLIB:strmiids.lib",
            "-DEFAULTLIB:uuid.lib",
        ],
        "//conditions:default": [],
    }),
    linkstatic = True,
    deps = [
        ":raw_video_file_source",
        "//emulator/libs/gvk",
        "//emulator/libs/system",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/types:optional",
        "@aemu//base:aemu-base-headers",
        "@gfxstream//third_party/glm",
        "@libjpeg_turbo//:jpeg",
        "@libpng//:png",
        "@libyuv",
        "@nlohmann_json//:json",
        "@tinygltf",
        "@tinyobjloader",
        "@vulkan-headers//:vulkan_headers",
    ] + select({
        "@platforms//os:macos": [":webcam_source_darwin"],
        "//conditions:default": [],
    }),
    alwayslink = True,
)
