load("@goldfish_build//rules:clang_tidy.bzl", "clang_tidy_test")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "os",
    srcs = [
        "dynamic_library.cc",
    ],
    hdrs = [
        "include/goldfish/os/dynamic_library.h",
        "include/goldfish/os/temp_failure_retry.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//emulator/libs/base",
    ],
    alwayslink = True,
)

cc_test(
    name = "os_unittests",
    size = "small",
    srcs = [
        "todo.cc",
    ],
    includes = ["test"],
    visibility = ["//visibility:public"],
    deps = [
        ":os",
        "//emulator/libs/test:googletest_main",
    ],
)

clang_tidy_test(
    name = "tidy",
    targets = [
        ":os",
        ":os_unittests",
    ],
    tidy_config_file = "//:clang_tidy_config",
)
