load("@goldfish_build//rules:clang_tidy.bzl", "clang_tidy_test")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "SocketBuffer",
    srcs = [
        "socket_buffer.cc",
    ],
    hdrs = [
        "include/goldfish/socket_buffer.h",
    ],
    includes = ["include"],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//emulator/libs/archive",
        "@abseil-cpp//absl/log:check",
    ],
)

cc_test(
    name = "SocketBuffer_unittests",
    size = "small",
    srcs = [
        "socket_buffer_tests.cc",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":SocketBuffer",
        "//emulator/libs/archive:DequeArchive",
        "//emulator/libs/test:googletest_main",
    ],
)

clang_tidy_test(
    name = "tidy",
    targets = [
        ":SocketBuffer",
        ":SocketBuffer_unittests",
    ],
    tidy_config_file = "//:clang_tidy_config",
)
