load("@aemu//tools/clang_tidy:defs.bzl", "clang_tidy_test")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "broadcasting",
    hdrs = [
        "include/goldfish/broadcasting/broadcasting.h",
    ],
    includes = ["include"],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/synchronization",
    ],
)

cc_test(
    name = "broadcasting_unittests",
    size = "small",
    srcs = [
        "broadcasting_tests.cc",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":broadcasting",
        "//emulator/libs/test:googletest_main",
        "@abseil-cpp//absl/synchronization",
    ],
)

clang_tidy_test(
    name = "tidy",
    targets = [
        ":broadcasting",
        ":broadcasting_unittests",
    ],
    tidy_config_file = "//:clang_tidy_config",
)
