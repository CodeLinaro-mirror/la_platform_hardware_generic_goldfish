load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "zigzag",
    hdrs = [
        "include/goldfish/archive/zigzag/zigzag.h",
    ],
    includes = ["include"],
    visibility = [
        "//visibility:public",
    ],
)

cc_test(
    name = "zigzag_unittests",
    size = "small",
    srcs = [
        "zigzag_tests.cc",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":zigzag",
        "//emulator/libs/test:googletest_main",
    ],
)

cc_library(
    name = "archive",
    hdrs = [
        "include/goldfish/archive/reader.h",
        "include/goldfish/archive/writer.h",
    ],
    includes = ["include"],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        ":zigzag",
    ],
)

cc_library(
    name = "DequeArchive",
    srcs = [
        "deque_archive.cc",
    ],
    hdrs = [
        "include/goldfish/archive/deque_archive.h",
        "include/goldfish/archive/deque_reader.h",
        "include/goldfish/archive/deque_writer.h",
    ],
    includes = ["include"],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        ":archive",
        "//emulator/libs/debug",
    ],
)

cc_test(
    name = "reader_writer_unittests",
    size = "small",
    srcs = [
        "reader_writer_tests.cc",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":DequeArchive",
        "//emulator/libs/test:googletest_main",
    ],
)

cc_library(
    name = "QEMUFileArchive",
    srcs = ["qemu_file_archive.cc"],
    hdrs = [
        "include/goldfish/archive/qemu_file_reader.h",
        "include/goldfish/archive/qemu_file_writer.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        ":archive",
        "@qemu//:qemu-headers-exported",
    ],
