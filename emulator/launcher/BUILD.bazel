        "//conditions:default": [
            "//emulator/sdk/system_images/minigbm-x86_64:minigbm",
            "@android16k-x86_64//:system_image",
        ],
    }) + [
        "//emulator/sdk:sdk-marker-files",
    ],
    deps = [
        ":emulator_lib",
        "@rules_python//python/runfiles",
    ],
)

