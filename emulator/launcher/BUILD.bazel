selects.config_setting_group(
    name = "darwin_aarch64",
    match_all = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

selects.config_setting_group(
    name = "darwin_x86_64",
    match_all = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

collect_plugins(
    name = "plugins",
    output_dir = "lib/qemu",
    plugins = [
        "//emulator/plugin:goldfish_x86_64",
        "@crosvm//:rutabaga_ffi",
    ] + select({
        "darwin_aarch64": [
            "//emulator/plugin:goldfish_aarch64",
            "//emulator/plugin:goldfish_riscv64",
        ],
        "@platforms//os:linux": [
            "//emulator/plugin:goldfish_aarch64",
            "//emulator/plugin:goldfish_riscv64",
            # For old netsimd prebuilt
            "@goldfish_prebuilts_common//vulkan:linux_libc++",
        ],
        "@platforms//os:windows": [
            # We don't build Qemu system aarch64 or riscv64 on Windows.
        ],
        "//conditions:default": [],
    }),
)

collect_plugins(
    name = "vulkan_icds",
    output_dir = "lib64/vulkan",
    plugins = select({
        "darwin_aarch64": [
            "@goldfish_prebuilts_common//vulkan:icds_darwin_aarch64",
            "@goldfish_prebuilts_common//vulkan:lib_darwin_aarch64",
        ],
        "@platforms//os:linux": [
            "@goldfish_prebuilts_common//vulkan:icds_linux_x86_64",
            "@goldfish_prebuilts_common//vulkan:lib_linux_x86_64",
        ],
        "@platforms//os:windows": [
            "@goldfish_prebuilts_common//vulkan:icds_windows_x86_64",
            "@goldfish_prebuilts_common//vulkan:lib_windows_x86_64",
        ],
        "//conditions:default": [],
    }),
)

collect_plugins(
    name = "lib64gl",
    output_dir = "lib64",
    plugins = select({
        "darwin_aarch64": [
            "@goldfish_prebuilts_common//ANGLE:lib_darwin_aarch64",
            "@goldfish_prebuilts_common//vulkan:lib_darwin_aarch64",
            "@goldfish_prebuilts_common//vulkan:icds_darwin_aarch64",
        ],
        "@platforms//os:linux": [
            "@goldfish_prebuilts_common//swiftshader:lib_linux_x86_64",
        ],
        "@platforms//os:windows": [
            "@goldfish_prebuilts_common//ANGLE:lib_windows_x86_64",
            "@goldfish_prebuilts_common//vulkan:lib_windows_x86_64",
            "@goldfish_prebuilts_common//vulkan:icds_windows_x86_64",
