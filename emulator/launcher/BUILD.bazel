        "//emulator/libs/async:libuv_process_launcher",
        "//emulator/libs/async:libuv_signal_handlers",
        "//emulator/libs/async:libuv_sockets",
        "//emulator/libs/cpu",
        "//emulator/libs/system",
        "//emulator/libs/system:bazel_info",
        "//emulator/modem_simulator",
        "//emulator/tools:aemu_version",
