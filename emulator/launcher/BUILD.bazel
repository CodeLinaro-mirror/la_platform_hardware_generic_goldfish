load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_binary", "py_library")
load("//emulator/tools:plugins.bzl", "collect_plugins")
load("launcher_test.bzl", "create_launch_emulator_test")

cc_library(
    name = "input_paths",
    srcs = ["src/android/goldfish/input_paths.cpp"],
    hdrs = ["include/android/goldfish/input_paths.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//android/async:uv_to_absl",
        "//android/system",
        "//emulator/config:config_dirs",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/status:statusor",
        "@aemu//base:aemu-base",
        "@libuv",
    ],
)

cc_library(
    name = "emulator_config",
    hdrs = ["include/android/goldfish/emulator_config.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        ":input_paths",
        "//emulator/cmdline",
        "//emulator/config:avd",
    ],
)

cc_library(
    name = "device",
    hdrs = ["include/android/goldfish/device.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        ":emulator_config",
    ],
)

cc_library(
    name = "logconfig",
    srcs = [
        "src/android/goldfish/logging.cpp",
    ],
    hdrs = [
        "include/android/goldfish/logging.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//emulator/cmdline",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:initialize",
        "@abseil-cpp//absl/strings",
    ],
)

cc_test(
    name = "logging_test",
    srcs = ["test/android/goldfish/logging_unittest.cpp"],
    deps = [
        ":logconfig",
        "//android/logging:backend",
        "//android/system:googletest_main",
        "//android/system:test-headers",
        "@abseil-cpp//absl/strings",
    ],
)

cc_library(
    name = "bootconfig",
    srcs = ["src/android/goldfish/bootconfig.cpp"],
    hdrs = ["src/android/goldfish/bootconfig.h"],
    includes = ["src"],
    visibility = ["//visibility:public"],
    deps = ["//android/system"],
)

cc_test(
    name = "bootconfig_test",
    srcs = ["test/android/goldfish/bootconfig_unittest.cpp"],
    deps = [
        ":bootconfig",
        "//android/logging:backend",
        "//android/system:googletest_main",
        "//android/system:test-headers",
    ],
)

cc_library(
    name = "emulator",
    srcs = [
        "include/android/goldfish/emulator.h",
        "src/android/goldfish/emulator.cpp",
    ],
    # Qemu roms needed for unittests - Emulator check that it is available.
    data = ["@qemu//:qemu-roms"],
    visibility = ["//visibility:public"],
    deps = [
        ":emulator_config",
        ":input_paths",
        "//android/async:launch_config",
        "//android/system",
        "//emulator/cmdline",
        "//emulator/config:avd",
        "//emulator/crashreport:detectors",
        "//emulator/launcher/src/android/goldfish/devices:adb_device",
        "//emulator/launcher/src/android/goldfish/devices:audio_device",
        "//emulator/launcher/src/android/goldfish/devices:avd_info_device",
        "//emulator/launcher/src/android/goldfish/devices:cpu_device",
        "//emulator/launcher/src/android/goldfish/devices:display_device",
        "//emulator/launcher/src/android/goldfish/devices:gpu_device",
        "//emulator/launcher/src/android/goldfish/devices:grpc_device",
        "//emulator/launcher/src/android/goldfish/devices:initrd_device",
        "//emulator/launcher/src/android/goldfish/devices:kernel_device",
        "//emulator/launcher/src/android/goldfish/devices:machine",
        "//emulator/launcher/src/android/goldfish/devices:memory_device",
        "//emulator/launcher/src/android/goldfish/devices:network_device",
        "//emulator/launcher/src/android/goldfish/devices:parameter_list",
        "//emulator/launcher/src/android/goldfish/devices:wifi_device",
        "//emulator/launcher/src/android/goldfish/devices/drives:configure_drives",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@aemu//base:aemu-base",
    ] + select({
        "@platforms//os:windows": [
            "//android/windows/posix:compat",
        ],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "netsimd",
    srcs = ["src/android/goldfish/netsimd.cpp"],
    hdrs = ["include/android/goldfish/netsimd.h"],
    includes = ["include"],
    deps = [
        "//android/async:launch_config",
        "//android/network",
        "//emulator/cmdline",
        "//emulator/grpc/client:emulator_grpc_client",
        "@grpc//:grpc++",
    ],
)

selects.config_setting_group(
    name = "darwin_aarch64",
    match_all = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

selects.config_setting_group(
    name = "darwin_x86_64",
    match_all = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

collect_plugins(
    name = "plugins",
    output_dir = "lib/qemu",
    plugins = [
        "//emulator/plugin:goldfish_x86_64",
        "@crosvm//:rutabaga_ffi",
    ] + select({
        "darwin_aarch64": [
            "//emulator/plugin:goldfish_aarch64",
            "//emulator/plugin:goldfish_riscv64",
        ],
        "@platforms//os:linux": [
            "//emulator/plugin:goldfish_aarch64",
            "//emulator/plugin:goldfish_riscv64",
            # For old netsimd prebuilt
            "@goldfish_prebuilts_common//vulkan:linux_libc++",
        ],
        "@platforms//os:windows": [
            # We don't build Qemu system aarch64 or riscv64 on Windows.
        ],
        "//conditions:default": [],
    }),
)

collect_plugins(
    name = "vulkan_icds",
    output_dir = "lib64/vulkan",
    plugins = select({
        "darwin_aarch64": [
            "@goldfish_prebuilts_common//vulkan:icds_darwin_aarch64",
            "@goldfish_prebuilts_common//vulkan:lib_darwin_aarch64",
        ],
        "@platforms//os:linux": [
            "@goldfish_prebuilts_common//vulkan:icds_linux_x86_64",
            "@goldfish_prebuilts_common//vulkan:lib_linux_x86_64",
        ],
        "@platforms//os:windows": [
            "@goldfish_prebuilts_common//vulkan:icds_windows_x86_64",
            "@goldfish_prebuilts_common//vulkan:lib_windows_x86_64",
        ],
        "//conditions:default": [],
    }),
)

collect_plugins(
    name = "lib64gl",
    output_dir = "lib64",
    plugins = select({
        "darwin_aarch64": [
            "@goldfish_prebuilts_common//ANGLE:lib_darwin_aarch64",
            "@goldfish_prebuilts_common//vulkan:lib_darwin_aarch64",
            "@goldfish_prebuilts_common//vulkan:icds_darwin_aarch64",
        ],
        "@platforms//os:linux": [
            "@goldfish_prebuilts_common//swiftshader:lib_linux_x86_64",
        ],
        "@platforms//os:windows": [
            "@goldfish_prebuilts_common//ANGLE:lib_windows_x86_64",
            "@goldfish_prebuilts_common//vulkan:lib_windows_x86_64",
            "@goldfish_prebuilts_common//vulkan:icds_windows_x86_64",
        ],
        "//conditions:default": [],
    }),
)

collect_plugins(
    name = "binaries",
    output_dir = "bin",
    plugins = [
        "//emulator/crashreport",
        "//third_party/sparse:img2simg",
        "@qemu//:qemu-img",
        "@crashpad//handler:crashpad_handler",
        #"@netsim//:netsimd",
    ] + select({
        "@platforms//os:windows": [
            "@goldfish_prebuilts_common//netsim:netsim_windows_x86_64",
            "@qemu//:qemu-system-x86_64",
        ],
        "@platforms//os:macos": [
            "@goldfish_prebuilts_common//netsim:netsim_darwin_aarch64",
            "@qemu//:qemu-system-aarch64_signed",
            "@qemu//:qemu-system-riscv64_signed",
            "@qemu//:qemu-system-x86_64_signed",
        ],
        "//conditions:default": [
            "@goldfish_prebuilts_common//netsim:netsim_linux_x86_64",
            "@qemu//:qemu-system-aarch64",
            "@qemu//:qemu-system-riscv64",
            "@qemu//:qemu-system-x86_64",
        ],
    }),
)

collect_plugins(
    name = "roms",
    output_dir = "share/qemu",
    plugins = [
        "@qemu//:qemu-roms",
    ],
)

collect_plugins(
    name = "keymaps",
    output_dir = "share/qemu/keymaps",
    plugins = [
        "@qemu//:qemu-keymaps",
    ],
)

cc_binary(
    name = "launcher",
    srcs = ["src/android/goldfish/launcher.cpp"],
    data = [
        ":binaries",
        ":keymaps",
        ":lib64gl",
        ":plugins",
        ":roms",
        ":vulkan_icds",
        "//emulator/grpc/security:unsecure-emulator-access",
    ],
    linkopts = select({
        "@platforms//os:macos": ["-undefined error"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":emulator",
        ":input_paths",
        ":logconfig",
        ":netsimd",
        "//android/async:libuv_event_loop",
        "//android/async:libuv_process_launcher",
        "//android/async:libuv_signal_handlers",
        "//android/cpu",
        "//android/filesystems",
        "//android/system",
        "//emulator/adb/secrets",
        "//emulator/cmdline",
        "//emulator/crashreport:init",
        "//emulator/tools:aemu_version",
        "@abseil-cpp//absl/debugging:failure_signal_handler",
        "@abseil-cpp//absl/debugging:symbolize",
        "@abseil-cpp//absl/flags:flag",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/log:initialize",
        "@aemu//base:aemu-base",
        "@nlohmann_json//:singleheader-json",
        "@qemu//:qemu-headers",
    ],
)

create_launch_emulator_test(
    name = "can_launch_kernel_with_minigbm",
    params = [
        "-show-kernel",
        "-no-boot-anim",
    ],
    target_log_line = "'Linux version 6'",
    timeout_seconds = 30,
)

create_launch_emulator_test(
    name = "can_boot_with_minigbm",
    params = [
        "-show-kernel",
        "-no-boot-anim",
    ],
    target_log_line = "'Boot completed in \\d+ ms'",
    timeout_seconds = 180,
)

create_launch_emulator_test(
    # This tests validates that the we receive at least a series frames from the guest.
    name = "emulator_produces_pixels",
    params = [
        "-vmodule",
        "'PixmanDisplay=2'",
    ],
    target_log_line = "'updateSurface Display: 0 \\(1080x2400\\), seq: 25'",
    timeout_seconds = 180,
)

create_launch_emulator_test(
    name = "can_boot_with_minigbm_2x",
    params = [
        "-show-kernel",
        "-no-boot-anim",
    ],
    repeat = 1,
    target_log_line = "'Boot completed in \\d+ ms'",
    timeout_seconds = 180,
)

test_suite(
    name = "boot_tests",
    tags = ["manual"],
    tests = [
        ":can_boot_with_minigbm",
        ":can_boot_with_minigbm_2x",
        ":can_boot_with_minigbm_2x_zip",
        ":can_boot_with_minigbm_zip",
        ":can_launch_kernel_with_minigbm",
        ":can_launch_kernel_with_minigbm_zip",
        ":emulator_produces_pixels",
    ],
)

py_library(
    name = "emulator_lib",
    srcs = ["src/emulator_lib.py"],
    visibility = ["//visibility:__pkg__"],
    deps = ["@rules_python//python/runfiles"],
)

py_binary(
    name = "launch_emulator",
    srcs = ["src/launch_emulator.py"],
    data = [
        ":launcher",
    ] + select({
        "@platforms//os:macos": [
            "//emulator/sdk/system_images/minigbm-arm64-v8a:minigbm",
            "@android_minigbm16k-arm64-v8a//:system_image",
        ],
        "//conditions:default": [
            "//emulator/sdk/system_images/minigbm-x86_64:minigbm",
            "@android_minigbm16k-x86_64//:system_image",
        ],
    }) + [
        "//emulator/sdk:sdk-marker-files",
    ],
    deps = [
        ":emulator_lib",
        "@rules_python//python/runfiles",
    ],
)
