        "//conditions:default": [],
    }),
)

collect_plugins(
    name = "binaries",
    output_dir = "bin",
    plugins = [
        "//emulator/crashreport",
        "//third_party/sparse:img2simg",
        "@qemu//:qemu-img",
        "@crashpad//handler:crashpad_handler",
        #"@netsim//:netsimd",
    ] + select({
        "@platforms//os:windows": [
            "@goldfish_prebuilts_common//netsim:netsim_windows_x86_64",
            "@qemu//:qemu-system-x86_64",
        ],
        "@platforms//os:macos": [
            "@goldfish_prebuilts_common//netsim:netsim_darwin_aarch64",
            "@qemu//:qemu-system-aarch64_signed",
            "@qemu//:qemu-system-riscv64_signed",
            "@qemu//:qemu-system-x86_64_signed",
        ],
        "//conditions:default": [
            "@goldfish_prebuilts_common//netsim:netsim_linux_x86_64",
            "@qemu//:qemu-system-aarch64",
            "@qemu//:qemu-system-riscv64",
            "@qemu//:qemu-system-x86_64",
        ],
    }),
    renames = select({
        "@platforms//os:macos": {
            "@qemu//:qemu-system-x86_64_signed": "qemu-system-x86_64",
            "@qemu//:qemu-system-aarch64_signed": "qemu-system-aarch64",
        },
        "//conditions:default": {},
    }),
)

collect_plugins(
    name = "roms",
    output_dir = "share/qemu",
    plugins = ["@qemu//:qemu-roms"],
)

collect_plugins(
    name = "keymaps",
    output_dir = "share/qemu/keymaps",
    plugins = ["@qemu//:qemu-keymaps"],
)

collect_plugins(
    name = "unsecure-emulator-access",
    output_dir = "lib",
    plugins = ["//emulator/grpc/security:unsecure-emulator-access"],
    renames = {
        "//emulator/grpc/security:unsecure-emulator-access": "emulator_access.json",
    },
    # Visibility needed by unit tests.
    visibility = [":__subpackages__"],
)

filegroup(
    name = "advanced_features_ini",
    srcs = ["data/advancedFeatures.ini"],
    visibility = ["//visibility:public"],
)

collect_plugins(
    name = "advanced_features",
    output_dir = "lib",
    plugins = [":advanced_features_ini"],
)

