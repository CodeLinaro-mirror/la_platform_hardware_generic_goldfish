load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "headers",
    hdrs = [
        "include/android/gps/GpsDevice.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//emulator/hal/connector:connector_registry",
        "@abseil-cpp//absl/status",
        "@aemu//base:event-support",
    ],
)

cc_library(
    name = "gps",
    srcs = [
        "src/gps/GpsDevice.cpp",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":headers",
        "//emulator/hal/connector:PingTopic",
        "//emulator/hal/connector:cable",
        "//emulator/hal/connector:qemud",
        "//emulator/libs/gps",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/strings:str_format",
    ],
    alwayslink = True,
)

cc_test(
    name = "gps_unittests",
    srcs = [
        "test/gps/GpsDevice_unittest.cpp",
    ],
    includes = ["test"],
    linkopts = select({
        "@platforms//os:macos": ["-undefined error"],
        "//conditions:default": [],
    }),
    deps = [
        ":gps",
        "//android/system:googletest_main",
        "//android/system:test-headers",
        "//emulator/config:avd-test",
        "//emulator/hal/connector:test-helpers",
        "//emulator/hal/plug:fake_vsock",
    ],
)

cc_library(
    name = "test_gps",
    hdrs = [
        "test/FakeGpsDevice.h",
    ],
    includes = ["test"],
    visibility = ["//visibility:public"],
    deps = [
        ":headers",
    ],
)
