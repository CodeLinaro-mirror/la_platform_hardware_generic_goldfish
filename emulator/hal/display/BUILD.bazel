load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "headers",
    hdrs = [
        "include/android/goldfish/display/Display.h",
        "include/android/goldfish/display/MultiDisplay.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//hardware/generic/goldfish/emulator/android-grpc/event-stream",
        # "//hardware/generic/goldfish/emulator/android-grpc/services/emulator-controller/proto:emulator_controller_cc_grpc",
        "@com_google_absl//absl/status",
        "@com_google_absl//absl/time",
    ],
)

cc_library(
    name = "display",
    srcs = [
        "src/android/goldfish/display/DefaultDisplay.cpp",
        "src/android/goldfish/display/DefaultDisplay.h",
        "src/android/goldfish/display/MultiDisplay.cpp",
        "src/android/goldfish/display/NullDisplay.h",
        "src/android/goldfish/display/virtio-bridge.c",
        "src/android/goldfish/display/virtio-bridge.h",
    ],
    includes = ["src"],
    linkstatic = False,
    visibility = ["//visibility:public"],
    deps = [
        ":headers",
        "//external/qemu:libmodule-common",
        "//external/qemu:qemu-headers",
        "//hardware/generic/goldfish/emulator/android-grpc/event-stream",
        "//hardware/generic/goldfish/emulator/hal/sensors",
        "//hardware/generic/goldfish/emulator/plugin/avd:avd_hdrs",
        "@com_google_absl//absl/strings",
        "@pixman//:pixman-1",
        "@pixman//:pixman_simd",
    ],
    alwayslink = True,
)

cc_library(
    name = "test-display",
    srcs = [
        "test/MockDisplay.h",
    ],
    includes = ["test"],
    visibility = ["//visibility:public"],
    deps = [
        ":headers",
    ],
)

cc_test(
    name = "display_unittests",
    srcs = [
        "test/DisplayTest.cpp",
        "test/QemuStubs.c",
    ],
    includes = ["test"],
    deps = [
        ":display",
        "@com_google_googletest//:gtest_main",
    ],
)
