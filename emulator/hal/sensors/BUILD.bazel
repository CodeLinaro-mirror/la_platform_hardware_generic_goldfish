load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "sensors",
    srcs = [
        "sensor_device.cc",
    ],
    hdrs = [
        "include/android/base/goldfish/devices/sensor/sensor_device.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//android/logging:absl-c-bridge",
        "//android/system",
        "//emulator/config:device_type",
        "//emulator/config:hardware_config",
        "//emulator/hal/connector:connector_registry",
        "//emulator/hal/connector:qemud",
        "//emulator/hal/plug:hal_plug",
        "//emulator/libs/physics",
        "//emulator/libs/sensors",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@aemu//base:aemu-base",
        "@aemu//base:event-support",
        "@gfxstream//third_party/glm",
    ],
    alwayslink = True,
)

cc_test(
    name = "sensors_unittests",
    srcs = [
        "sensor_device_test.cc",
    ],
    includes = ["test"],
    visibility = ["//visibility:public"],
    deps = [
        ":sensors",
        "//android/system:googletest_main",
        "//android/system:test-headers",
        "//emulator/config:fake_hardware_config",
        "//emulator/hal/connector:test-helpers",
        "//emulator/hal/plug:fake_vsock",
    ],
