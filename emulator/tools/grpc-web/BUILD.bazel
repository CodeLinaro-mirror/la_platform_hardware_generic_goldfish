load("@goldfish_build//rules:clang_tidy.bzl", "clang_tidy_test")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "grpc_web_protocol",
    srcs = ["src/grpc_web_protocol.cc"],
    hdrs = ["include/goldfish/grpcweb/grpc_web_protocol.h"],
    includes = ["include"],
    deps = [
        "//emulator/libs/http:http_messages",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/time",
        "@grpc//:grpc++",
    ],
)

cc_test(
    name = "grpc_web_protocol_test",
    srcs = ["test/grpc_web_protocol_test.cc"],
    deps = [
        ":grpc_web_protocol",
        "//emulator/libs/test:googletest_main",
    ],
)

cc_library(
    name = "grpc_web_server",
    srcs = ["src/grpc_web_server.cc"],
    hdrs = ["include/goldfish/grpcweb/grpc_web_server.h"],
    includes = ["include"],
    deps = [
        ":grpc_web_protocol",
        "//emulator/libs/async:async_api",
        "//emulator/libs/http:http_server",
        "//emulator/libs/http:web_server",
        "//emulator/libs/network",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@grpc//:grpc++",
    ],
)

cc_test(
    name = "grpc_web_server_test",
    srcs = ["test/grpc_web_server_test.cc"],
    deps = [
        ":grpc_web_server",
        "//emulator/libs/async:libuv_event_loop",
        "//emulator/libs/async:libuv_sockets",
        "//emulator/libs/test:googletest_main",
        "@abseil-cpp//absl/synchronization",
    ],
)

cc_binary(
    name = "grpc-web-proxy",
    srcs = ["src/main.cc"],
    deps = [
        ":grpc_web_server",
        "//emulator/libs/async:libuv_event_loop",
        "//emulator/libs/async:libuv_sockets",
        "//emulator/libs/async:threaded_event_loop",
        "//emulator/libs/grpc_client",
        "//emulator/libs/network",
        "@abseil-cpp//absl/flags:flag",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/flags:usage",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:flags",
        "@abseil-cpp//absl/log:globals",
        "@abseil-cpp//absl/log:initialize",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/synchronization",
        "@grpc//:grpc++",
    ],
)

clang_tidy_test(
    name = "tidy",
    targets = [
        ":grpc-web-proxy",
        ":grpc_web_protocol",
        ":grpc_web_server",
    ],
    tidy_config_file = "//:clang_tidy_config",
)
