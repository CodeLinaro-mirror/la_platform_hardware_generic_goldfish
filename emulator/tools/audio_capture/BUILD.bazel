load("@goldfish_build//rules:clang_tidy.bzl", "clang_tidy_test")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("//emulator/tools:cc_binary_with_manifest.bzl", "cc_binary_with_manifest")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "wav_writer",
    srcs = ["wav_writer.cc"],
    hdrs = ["wav_writer.h"],
    deps = [
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
    ],
)

cc_test(
    name = "wav_writer_test",
    size = "small",
    srcs = ["wav_writer_test.cc"],
    deps = [
        ":wav_writer",
        "//emulator/libs/test:googletest_main",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:status_matchers",
    ],
)

cc_binary_with_manifest(
    name = "audio_capture",
    srcs = ["audio_capture.cc"],
    deps = [
        ":wav_writer",
        "//emulator/libs/grpc_client",
        "//emulator/libs/grpc_utils:absl_translate",
        "@abseil-cpp//absl/flags:flag",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/flags:usage",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:globals",
        "@abseil-cpp//absl/log:initialize",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings:str_format",
        "@abseil-cpp//absl/time",
        "@aemu//protos/services/emulator-controller:emulator_controller_cc_grpc",
        "@grpc//:grpc++",
    ],
)

clang_tidy_test(
    name = "tidy",
    targets = [
        ":audio_capture",
        ":wav_writer",
        ":wav_writer_test",
    ],
    tidy_config_file = "//:clang_tidy_config",
)
