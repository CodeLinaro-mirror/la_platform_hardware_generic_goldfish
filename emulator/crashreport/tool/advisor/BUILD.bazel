load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_test.bzl", "py_test")

py_binary(
    name = "advisor",
    srcs = [
        "advisor.py",
        "api.py",
        "client.py",
        "context.py",
        "dump.py",
        "metadata.py",
        "rca.py",
        "symbols.py",
    ],
    data = [
        "crash_advisor.md",
        "//emulator/crashreport/tool:crashreport",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@aemu//tools/libs_python:ab",
        "@bazel_tools//tools/python/runfiles",
    ],
)

py_test(
    name = "advisor_test",
    srcs = ["advisor_test.py"],
    data = [
        "crash_advisor.md",
        "//emulator/crashreport/tool:crashreport",
    ],
    deps = [
        ":advisor",
        "@aemu//tools/libs_python:ab",
        "@bazel_tools//tools/python/runfiles",
    ],
)

filegroup(
    name = "docs",
    srcs = [
        "README.md",
        "crash_advisor.md",
    ],
    visibility = ["//visibility:public"],
)
