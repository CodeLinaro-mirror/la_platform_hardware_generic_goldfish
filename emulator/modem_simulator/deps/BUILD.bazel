load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "deps",
    srcs = [
        "files.cc",
        "shared_buf.cc",
        "shared_fd.cc",
    ],
    hdrs = [
        "include/common/libs/fs/shared_buf.h",
        "include/common/libs/fs/shared_fd.h",
        "include/common/libs/fs/shared_select.h",
        "include/common/libs/utils/files.h",
    ],
    includes = ["include"],
    visibility = ["//emulator/modem_simulator:__subpackages__"],
    deps = [
        "//emulator/libs/os",
        "//emulator/libs/parsing",
        "@abseil-cpp//absl/strings:str_format",
    ] + select({
        "@platforms//os:windows": ["@aemu//windows:compat-hdrs"],
        "//conditions:default": [],
    }),
)

cc_test(
    name = "deps_unittests",
    srcs = [
        "shared_fd_test.cc",
    ],
    deps = [
        ":deps",
        "//emulator/libs/test:googletest_main",
    ],
)
