package(default_visibility = ["//visibility:public"])


# This is the build file for the cuttlefish modem_simulator
# It lives here as we are using cuttlefish from android main, which will not
# allow bazel build files.
# The actual path is:
#    path = "device/google/cuttlefish/host/commands/modem_simulator"

cc_library(
    name = "modem_simulator_lib",
    srcs = [
        "call_service.cpp",
        "channel_monitor.cpp",
        "command_parser.cpp",
        "data_service.cpp",
        "misc_service.cpp",
        "modem_service.cpp",
        "modem_simulator.cpp",
        "network_service.cpp",
        "nvram_config.cpp",
        "pdu_parser.cpp",
        "sim_service.cpp",
        "sms_service.cpp",
        "stk_service.cpp",
        "sup_service.cpp",
        "thread_looper.cpp",
    ],
    include_prefix = "host/commands/modem_simulator",
    hdrs = [
        "call_service.h",
        "channel_monitor.h",
        "command_parser.h",
        "data_service.h",
        "device_config.h",
        "misc_service.h",
        "modem_service.h",
        "modem_simulator.h",
        "network_service.h",
        "network_service_constants.h",
        "nvram_config.h",
        "pdu_parser.h",
        "sim_service.h",
        "sms_service.h",
        "stk_service.h",
        "sup_service.h",
        "thread_looper.h",
    ],
    copts = [
        "-fexceptions",
        "-Wno-unused-const-variable",
    ],
    # strip_include_prefix = "//cuttlefish",
    deps = [
        "@jsoncpp",
        "@tinyxml2",
        "@modem_simulator_common//:common",
        "@modem_simulator_android_base//:android-base",
    ],
)


cc_library(
    name = "modem_simulator_test_lib",
    hdrs = [
        "unittest/iccfile.txt",
    ],
)

cc_test(
    name = "modem_simulator_test",
    srcs = [
        "unittest/command_parser_test.cpp",
        "unittest/pdu_parser_test.cpp",
    ],
    deps = [
        ":modem_simulator_lib",
        ":modem_simulator_test_lib",
        "@com_google_googletest//:gtest_main",
        "@gflags",
    ],
)
