load("@goldfish_build//rules:clang_tidy.bzl", "clang_tidy_test")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")
load("@rules_cc//cc:objc_library.bzl", "objc_library")

package(default_visibility = ["//visibility:public"])

WEBRTC_LINKOPTS = select({
    "@platforms//os:macos": [
        "-Wl,-ObjC",
        "-framework VideoToolbox",
        "-framework CoreMedia",
        "-framework AVFoundation",
        "-framework CoreVideo",
        "-framework Foundation",
    ],
    "//conditions:default": [],
})

WEBRTC_COPTS = select({
    "@platforms//os:windows": ["/GR-"],
    "//conditions:default": ["-fno-rtti"],
})

cc_library(
    name = "emulator_client",
    srcs = ["client/emulator_client.cc"],
    hdrs = ["include/goldfish/videobridge/emulator_client.h"],
    strip_include_prefix = "include",
    deps = [
        "//emulator/libs/grpc_client",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/time",
        "@aemu//protos/services/emulator-controller:emulator_controller_cc_grpc",
        "@grpc//:grpc++",
    ],
)

cc_binary(
    name = "videobridge",
    srcs = ["videobridge.cpp"],
    copts = WEBRTC_COPTS,
    linkopts = WEBRTC_LINKOPTS,
    deps = [
        ":emulator_client",
        ":grpc_media_providers",
        ":rtc_service",
        ":videobridge_codecs",
        "//emulator/libs/grpc_security",
        "@abseil-cpp//absl/flags:flag",
        "@abseil-cpp//absl/flags:parse",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:flags",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/time",
        "@grpc//:grpc++",
    ],
)

objc_library(
    name = "videobridge_codecs_objc",
    srcs = ["core/mac/codec_factories_mac.mm"],
    hdrs = ["include/goldfish/videobridge/codec_factories.h"],
    copts = [
        "-fno-rtti",
        "-ObjC++",
        "-fobjc-arc",
    ],
    includes = ["include"],
    deps = [
        "@webrtc//api/video_codecs:builtin_video_decoder_factory",
        "@webrtc//api/video_codecs:builtin_video_encoder_factory",
        "@webrtc//pc:video_track_source_proxy",
        "@webrtc//sdk:native_api",
        "@webrtc//sdk:videotoolbox_objc",
    ],
)

cc_library(
    name = "videobridge_codecs_win",
    srcs = ["core/win/mf_video_encoder_h264.cc"],
    hdrs = [
        "core/win/mf_video_encoder_h264.h",
        "include/goldfish/videobridge/codec_factories.h",
    ],
    copts = WEBRTC_COPTS,
    features = ["-parse_headers"],
    includes = [
        ".",
        "include",
    ],
    linkopts = [
        "-DEFAULTLIB:mfplat.lib",
        "-DEFAULTLIB:mfuuid.lib",
        "-DEFAULTLIB:ole32.lib",
        "-DEFAULTLIB:strmiids.lib",
        "-DEFAULTLIB:uuid.lib",
    ],
    target_compatible_with = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "@abseil-cpp//absl/synchronization",
        "@libyuv",
        "@webrtc//api:scoped_refptr",
        "@webrtc//api/video_codecs:video_codecs_api",
        "@webrtc//modules/video_coding:video_codec_interface",
        "@webrtc//rtc_base:checks",
        "@webrtc//rtc_base:logging",
    ],
)

cc_library(
    name = "videobridge_codecs",
    srcs = select({
        "@platforms//os:macos": [],
        "//conditions:default": ["core/codec_factories.cc"],
    }),
    hdrs = ["include/goldfish/videobridge/codec_factories.h"],
    strip_include_prefix = "include",
    deps = select({
        "@platforms//os:macos": [":videobridge_codecs_objc"],
        "@platforms//os:windows": [
            ":videobridge_codecs_win",
            "@webrtc//api/video_codecs:builtin_video_decoder_factory",
            "@webrtc//api/video_codecs:builtin_video_encoder_factory",
        ],
        "//conditions:default": [
            "@webrtc//api/video_codecs:builtin_video_decoder_factory",
            "@webrtc//api/video_codecs:builtin_video_encoder_factory",
        ],
    }),
)

