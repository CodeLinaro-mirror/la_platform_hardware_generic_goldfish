load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_python//python:defs.bzl", "py_binary")

py_binary(
    name = "gen-hw-config",
    srcs = ["tools/gen-hw-config.py"],
)

# TODO(jansene): Port to host-common.
genrule(
    name = "hw-config-gen",
    srcs = ["data/hardware-properties.ini"],
    outs = ["include/avd/hw-config-defs.h"],
    cmd = "$(location :gen-hw-config) $(location data/hardware-properties.ini) $(location include/avd/hw-config-defs.h)",
    tools = [":gen-hw-config"],
)

cc_library(
    name = "hardware_config",
    srcs = [
        "hardware_config.cc",
        ":hw-config-gen",
    ],
    hdrs = ["include/android/goldfish/hardware_config.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//android/files",
        "@aemu//base:aemu-base",
    ],
)

cc_library(
    name = "fake_hardware_config",
    testonly = True,
    hdrs = ["test/android/goldfish/fake_hardware_config.h"],
    includes = ["test"],
    visibility = ["//visibility:public"],
    deps = [":hardware_config"],
)

cc_library(
    name = "emulator_advertisement",
    srcs = ["emulator_advertisement.cc"],
    hdrs = ["include/android/goldfish/emulator_advertisment.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//android/files",
        "//android/sockets",
        "@aemu//base:aemu-base",
    ],
)

cc_library(
    name = "device_type",
    hdrs = ["include/android/goldfish/device_type.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "config_dirs",
    srcs = ["config_dirs.cc"],
    hdrs = ["include/android/goldfish/config_dirs.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//android/system",
        "@abseil-cpp//absl/log",
        "@aemu//base:aemu-base",
    ],
)

cc_test(
    name = "config_dirs_test",
    size = "small",
    srcs = ["config_dirs_test.cc"],
    linkopts = select({
        "@platforms//os:macos": ["-undefined error"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":config_dirs",
        "//android/system",
        "//android/system:googletest_main",
        "//android/system:test-headers",
        "@abseil-cpp//absl/status:status_matchers",
    ],
)
