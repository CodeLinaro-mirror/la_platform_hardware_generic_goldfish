cc_test(
    name = "devices_unittests",
    size = "small",
    srcs = glob(
        [
            "test/*.cpp",
        ],
    ),
    copts = copts,
    deps = [
        ":connection_awaiter",
        ":connector_registry",
        ":devices",
        "//hardware/generic/goldfish/android/looper",
        "//hardware/generic/goldfish/android/sockets",
        "//hardware/generic/goldfish/emulator/libs/archive:DequeArchive",
        "@com_google_googletest//:gtest_main",
    ],
)

