copts = select({
    "@platforms//os:windows": [
        "/std:c++20",
    ],
    "//conditions:default": [
        "-std=c++20",
    ],
})

cc_library(
    name = "cable",
    srcs = [
        "cable.cpp",
    ],
    hdrs = [
        "include/goldfish/devices/cable/cable.h",
        "include/goldfish/devices/cable/saveload.h",
    ],
    copts = copts,
    includes = ["include"],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//hardware/generic/goldfish/emulator/libs/archive",
    ],
    alwayslink = True,
)

cc_library(
    name = "qemud",
    srcs = [
        "qemud.cpp",
    ],
    hdrs = [
        "include/goldfish/devices/qemud.h",
    ],
    copts = copts,
    includes = ["include"],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        ":cable",
    ],
    alwayslink = True,
)

cc_library(
    name = "PingTopic",
    hdrs = [
        "include/goldfish/devices/PingTopic.h",
    ],
    copts = copts,
    includes = ["include"],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//hardware/generic/goldfish/emulator/libs/broadcasting",
    ],
    alwayslink = True,
)

cc_library(
    name = "devices",
    srcs = [
        "Connector.cpp",
    ],
    hdrs = [
        "include/goldfish/devices/Connector.h",
    ],
    copts = copts,
    includes = ["include"],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        ":PingTopic",
        ":cable",
        ":qemud",
    ],
    alwayslink = True,
)

cc_test(
    name = "devices_unittests",
    size = "small",
    srcs = glob(
        [
            "test/*.cpp",
        ],
    ),
    copts = copts,
    deps = [
        ":devices",
        "//hardware/generic/goldfish/emulator/libs/archive:DequeArchive",
        "@com_google_googletest//:gtest_main",
    ],
)
