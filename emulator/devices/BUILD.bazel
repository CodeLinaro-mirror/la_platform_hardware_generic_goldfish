copts = select({
    "@platforms//os:windows": [
        "/std:c++20",
    ],
    "//conditions:default": [
        "-std=c++20",
    ],
})

cc_library(
    name = "cable",
    srcs = [
        "cable.cpp",
    ],
    hdrs = [
        "include/goldfish/devices/cable/cable.h",
        "include/goldfish/devices/cable/saveload.h",
    ],
    copts = copts,
    includes = ["include"],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "//hardware/generic/goldfish/emulator/libs/archive",
    ],
    alwayslink = True,
)

cc_library(
    name = "qemud",
    srcs = [
        "qemud.cpp",
    ],
    hdrs = [
        "include/goldfish/devices/qemud.h",
    ],
    copts = copts,
    includes = ["include"],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        ":cable",
    ],
    alwayslink = True,
)

cc_library(
    name = "PingTopic",
    hdrs = [
