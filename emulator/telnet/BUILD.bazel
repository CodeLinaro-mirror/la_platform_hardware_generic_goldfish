        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
    ],
)

cc_library(
    name = "legacy_console_bridge",
    srcs = [
        "legacy_console_bridge.cc",
        "screen_record_commands.cc",
        "screen_record_commands.h",
    ],
    hdrs = [
        "legacy_console_bridge.h",
    ],
    deps = [
        ":command_registry",
        ":line_command_handler",
        ":telnet_auth",
        "//emulator/libs/grpc_client",
        "//emulator/libs/grpc_utils:absl_translate",
        "//emulator/libs/status_macros",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@aemu//protos/services/emulator-controller:emulator_controller_cc_grpc",
        "@aemu//protos/services/incubating/recording:screen_recording_service_cc_grpc",
        "@aemu//protos/services/snapshot:snapshot_service_cc_grpc",
    ],
)

