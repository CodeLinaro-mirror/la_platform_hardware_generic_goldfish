load("@goldfish_build//rules:clang_tidy.bzl", "clang_tidy_test")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "telnet_auth",
    srcs = ["telnet_auth.cc"],
    hdrs = ["telnet_auth.h"],
    linkopts = select({
        "@platforms//os:windows": [
            "-DEFAULTLIB:advapi32.lib",
        ],
        "//conditions:default": [],
    }),
    deps = [
        "//emulator/libs/file",
        "//emulator/libs/system",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/random",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@tink_cc//tink:secret_data",
        "@tink_cc//tink:tink_cc",
    ],
)

cc_library(
    name = "line_command_handler",
    hdrs = ["line_command_handler.h"],
    deps = [
        "@abseil-cpp//absl/status:statusor",
    ],
)

cc_library(
    name = "console_server",
    srcs = ["console_server.cc"],
    hdrs = ["console_server.h"],
    deps = [
        ":line_command_handler",
        "//emulator/libs/async:async_api",
        "//emulator/libs/async:libuv_event_loop",
        "//emulator/libs/async:threaded_event_loop",
        "//emulator/libs/network",
        "@abseil-cpp//absl/container:flat_hash_map",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/synchronization",
    ],
)

cc_library(
    name = "legacy_console_controller",
    srcs = ["legacy_console_controller.cc"],
    hdrs = ["legacy_console_controller.h"],
    includes = ["."],
    deps = [
        ":console_server",
        ":legacy_console_bridge",
        ":line_command_handler",
        ":telnet_auth",
        "//emulator/libs/async:async_api",
        "//emulator/libs/async:libuv_event_loop",
        "//emulator/libs/network",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
    ],
)

cc_library(
    name = "command_registry",
    srcs = ["command_registry.cc"],
    hdrs = ["command_registry.h"],
    deps = [
        ":line_command_handler",
        "//emulator/libs/parsing",
