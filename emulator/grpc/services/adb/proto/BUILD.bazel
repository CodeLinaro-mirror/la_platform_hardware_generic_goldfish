load("@grpc//bazel:cc_grpc_library.bzl", "cc_grpc_library")
load("@rules_cc//cc:defs.bzl", "cc_proto_library")
load("@rules_proto//proto:defs.bzl", "proto_library")

package(default_visibility = ["//hardware/generic/goldfish/emulator/grpc:__subpackages__"])

proto_library(
    name = "adb_service_proto",
    srcs = ["adb_service.proto"],
    deps = ["@protobuf//:empty_proto"],
)

cc_proto_library(
    name = "adb_service_cc_proto",
    deps = [":adb_service_proto"],
)

cc_grpc_library(
    name = "adb_service_cc_grpc",
    srcs = [":adb_service_proto"],
    grpc_only = True,
    deps = [":adb_service_cc_proto"],
)
