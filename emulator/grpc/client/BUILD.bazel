load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_proto//proto:defs.bzl", "proto_library")

package(default_visibility = ["//visibility:public"])

proto_library(
    name = "grpc_endpoint_description_proto",
    srcs = ["proto/grpc_endpoint_description.proto"],
    strip_import_prefix = "proto",
    deps = ["@protobuf//:empty_proto"],
)

cc_proto_library(
    name = "grpc_endpoint_description_cc_proto",
    deps = [":grpc_endpoint_description_proto"],
)

cc_library(
    name = "emulator_grpc_client",
    srcs = [
        "emulator_grpc_client.cc",
        "grpc_channel_factory.cc",
        "grpc_channel_factory.h",
        "grpc_connection_monitor.cc",
        "grpc_connection_monitor.h",
    ],
    hdrs = ["include/android/emulation/control/emulator_grpc_client.h"],
    includes = ["include"],
    deps = [
        "//android/files:ini_file",
        "//emulator/grpc/client:grpc_endpoint_description_cc_proto",
        "//emulator/grpc/security",
        "//emulator/grpc/services/emulator_controller:emulator_controller_cc_grpc",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/synchronization",
        "@abseil-cpp//absl/time",
        "@aemu//base:event-support",
        "@grpc//:grpc++",
    ],
)

cc_test(
    name = "emulator_grpc_client_test",
    srcs = ["emulator_grpc_client_test.cc"],
    visibility = ["//visibility:public"],
    deps = [
        ":emulator_grpc_client",
        "//android/sockets",
        "//android/system:googletest_main",
        "//emulator/grpc/services/emulator_controller:emulator_controller_cc_grpc",
        "@abseil-cpp//absl/random",
        "@abseil-cpp//absl/synchronization",
        "@grpc//:grpc++",
    ],
)
