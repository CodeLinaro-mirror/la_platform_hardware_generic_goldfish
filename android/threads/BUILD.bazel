cc_library(
    name = "threads",
    srcs = [
        "src/android/base/threads/Async.cpp",
        "src/android/base/threads/FunctorThread.cpp",
        "src/android/base/threads/ThreadStore.cpp",
        "src/android/base/threads/internal/ParallelTaskBase.cpp",
        "src/android/base/threads/internal/ParallelTaskBase.h",
    ],
    hdrs = glob([
        "include/android/utils/*.h",
    ]),
    copts =
        select({
            "@platforms//os:windows": ["-Wno-microsoft-goto"],
            "//conditions:default": [],
