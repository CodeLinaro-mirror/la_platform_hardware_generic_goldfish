        "src/android/utils/bufprint_system.cpp",
        "src/android/utils/dirscanner.cpp",
        "src/android/utils/dirscanner.h",
        "src/android/utils/dll.c",
        "src/android/utils/file_data.c",
        "src/android/utils/filelock.cpp",
        "src/android/utils/lock.cpp",
        "src/android/utils/lock.h",
        "src/android/utils/path.cpp",
        "src/android/utils/path.h",
        "src/android/utils/path_system.cpp",
        "src/android/utils/system.c",
        "src/android/utils/tempfile.c",
