load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# It's an older code sir but it checks out
cc_library(
    name = "files",
    srcs = [
        "src/android/files/FileSystemWatcher.cpp",
        "src/android/files/IniFile.cpp",
    ] + select({
        "@platforms//os:windows": ["src/android/files/FileSystemWatcherWindows.cpp"],
        "@platforms//os:macos": ["src/android/files/FileSystemWatcherDarwin.cpp"],
        "@platforms//os:linux": ["src/android/files/FileSystemWatcherPosix.cpp"],
    }),
    hdrs = [
        "include/android/files/FileSystemWatcher.h",
        "include/android/files/IniFile.h",
    ],
    defines = [
        "__STDC_LIMIT_MACROS=1",
        "__STDC_FORMAT_MACROS=1",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//android/logging:absl-c-bridge",
        "//android/process",
        "//android/system",
        "@aemu//base:aemu-base",
    ],
)

cc_test(
    name = "files_unittests",
    size = "medium",
    srcs = [
        "test/android/files/FileSystemWatcher_unittest.cpp",
        "test/android/files/IniFile_unittest.cpp",
    ],
    linkopts = select({
        "@platforms//os:macos": ["-undefined error"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":files",
        "//android/system:googletest_main",
        "//android/system:test-headers",
        "@abseil-cpp//absl/log",
        "@aemu//base:aemu-base",
    ],
)
