load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

# It's an older code sir but it checks out
cc_library(
    name = "files",
    srcs = [
        "file_system_watcher.cc",
        "ini_file.cc",
    ] + select({
        "@platforms//os:windows": ["file_system_watcher_windows.cc"],
        "@platforms//os:macos": ["file_system_watcher_darwin.cc"],
        "@platforms//os:linux": ["file_system_watcher_posix.cc"],
    }),
    hdrs = [
        "include/android/base/file_system_watcher.h",
        "include/android/goldfish/ini_file.h",
    ],
    defines = [
        "__STDC_LIMIT_MACROS=1",
        "__STDC_FORMAT_MACROS=1",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "//android/logging:absl-c-bridge",
        "//android/process",
        "//android/system",
        "@aemu//base:aemu-base",
    ],
)

cc_test(
    name = "files_unittests",
    size = "medium",
    srcs = [
        "file_system_watcher_test.cc",
        "ini_file_test.cc",
    ],
    linkopts = select({
        "@platforms//os:macos": ["-undefined error"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":files",
        "//android/system",
        "//android/system:googletest_main",
        "//android/system:test-headers",
        "@abseil-cpp//absl/log",
        "@aemu//base:aemu-base",
    ],
)
