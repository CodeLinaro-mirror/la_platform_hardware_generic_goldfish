# It's an older code sir but it checks out
# This library contains a set of c based file abstractions that are used
# by some higher layers.
cc_library(
    name = "files",
    srcs = [
        "src/android/utils/assert.h",
        "src/android/utils/bufprint.c",
        "src/android/utils/bufprint.h",
        "src/android/utils/bufprint_system.cpp",
        "src/android/utils/dirscanner.cpp",
        "src/android/utils/dirscanner.h",
        "src/android/utils/dll.c",
        "src/android/utils/file_data.c",
        "src/android/utils/filelock.cpp",
        "src/android/utils/lock.cpp",
        "src/android/utils/lock.h",
        "src/android/utils/path.cpp",
        "src/android/utils/path_system.cpp",
        "src/android/utils/system.c",
        "src/android/utils/system.h",
        "src/android/utils/tempfile.c",
    ],
    hdrs = [
        "include/android/utils/dll.h",
        "include/android/utils/file_data.h",
        "include/android/utils/filelock.h",
        "include/android/utils/path.h",
        "include/android/utils/tempfile.h",
    ],
    defines = [
        "__STDC_LIMIT_MACROS=1",
        "__STDC_FORMAT_MACROS=1",
    ],
    includes = [
        "include",
        "src",
    ],
    linkopts = select({
        "@platforms//os:linux": ["-ldl"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//hardware/generic/goldfish/process",
        "//hardware/generic/goldfish/system",
        "//hardware/google/aemu/base:aemu-base",
    ],
)

cc_test(
    name = "files_unittests",
    size = "small",
    srcs = glob(
        ["test/**/*.cpp"],
        ["src/**/*.h"],
    ),
    deps = [
        ":files",
        "//hardware/generic/goldfish/system:test-headers",
        "@com_google_googletest//:gtest_main",
    ],
)
