load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "sockets",
    srcs = [
        "SocketErrors.h",
        "Winsock.h",
        "socket_utils.cc",
    ],
    hdrs = [
        "include/android/sockets/scoped_socket.h",
        "include/android/sockets/socket_utils.h",
    ],
    copts = select({
        "@platforms//os:windows": [
            "-Wno-microsoft-goto",
            "-Wno-macro-redefined",
        ],
        "//conditions:default": [],
    }),
    includes = ["include"],
    linkopts = select({
        "@platforms//os:windows": [
            "-DEFAULTLIB:Rpcrt4.lib",
            "-DEFAULTLIB:Ws2_32.lib",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//android/system",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:check",
        "@aemu//base:aemu-base",
    ],
)

cc_test(
    name = "sockets_unittests",
    srcs = ["socket_utils_test.cc"],
    linkopts = select({
        "@platforms//os:macos": ["-undefined error"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":sockets",
        "//android/system:googletest_main",
        "//android/system:test-headers",
    ],
)
