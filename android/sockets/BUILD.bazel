    ],
)

cc_test(
    name = "async_socket_perf",
    size = "small",
    srcs = ["test/android/base/sockets/AsyncSocket_perf.cpp"],
    copts = ["-Wno-deprecated-declarations"],
    includes = ["test"],
    deps = [
        ":test-sockets",
        "@com_github_google_benchmark//:benchmark",
    ],
)
