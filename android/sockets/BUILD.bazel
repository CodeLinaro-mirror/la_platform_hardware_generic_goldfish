load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "sockets",
    srcs =
        [
            "src/android/base/sockets/AsyncSocket.cpp",
            "src/android/base/sockets/AsyncSocketServer.cpp",
            "src/android/base/sockets/AsyncWriter.cpp",
            "src/android/base/sockets/ScopedSocketWatch.cpp",
            "src/android/base/sockets/SocketDrainer.cpp",
            "src/android/base/sockets/SocketUtils.cpp",
            "src/android/base/sockets/SocketWaiter.cpp",
            "src/android/utils/eintr_wrapper.c",
            "src/android/utils/eintr_wrapper.h",
            "src/android/utils/misc.c",
            "src/android/utils/misc.h",
            "src/android/utils/socket_drainer.cpp",
            "src/android/utils/socket_drainer.h",
            "src/android/utils/sockets.c",
            "src/android/utils/sockets.h",
            "src/android/utils/stralloc.c",
            "src/android/utils/stralloc.h",
        ],
    copts = select({
        "@platforms//os:windows": [
            "-Wno-microsoft-goto",
            "-Wno-macro-redefined",
        ],
        "//conditions:default": [],
    }),
    includes =
        [
            "include",
            "src",
        ],
    linkopts = select({
        "@platforms//os:windows": [
            "-DEFAULTLIB:Rpcrt4.lib",
            "-DEFAULTLIB:Ws2_32.lib",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps =
        [
            "//hardware/generic/goldfish/android/files",
            "//hardware/generic/goldfish/android/looper",
            "//hardware/generic/goldfish/android/memory",
            "//hardware/generic/goldfish/android/system",
            "//hardware/generic/goldfish/android/threads",
            "@aemu//base:aemu-base",
            "@com_google_absl//absl/log",
            "@com_google_absl//absl/log:check",
        ],
)

cc_library(
    name = "test-sockets",
    srcs = [
        "test/android/base/sockets/ChecksumSocket.cpp",
        "test/android/base/sockets/SimpleTestServer.cpp",
        "test/android/base/sockets/SimpleThreadLooper.cpp",
    ],
    hdrs = [
        "test/include/android/base/sockets/ChecksumCalculator.h",
        "test/include/android/base/sockets/ChecksumSocket.h",
        "test/include/android/base/sockets/SimpleTestServer.h",
        "test/include/android/base/sockets/SimpleThreadLooper.h",
    ],
    includes = ["test/include"],
    visibility = ["//visibility:public"],
    deps = [
        ":sockets",
        "@com_google_absl//absl/log",
        "@com_google_absl//absl/log:check",
    ],
)

cc_test(
    name = "sockets_unittests",
    srcs = [
        "test/android/base/sockets/AsyncSocketServer_unittest.cpp",
        "test/android/base/sockets/AsyncSocket_unittest.cpp",
        "test/android/base/sockets/ChecksumSocket.cpp",
        "test/android/base/sockets/ScopedSocketWatch_unittest.cpp",
        "test/android/base/sockets/ScopedSocket_unittest.cpp",
        "test/android/base/sockets/SimpleTestServer.cpp",
        "test/android/base/sockets/SimpleThreadLooper.cpp",
        "test/android/base/sockets/SocketDrainer_unittest.cpp",
        "test/android/base/sockets/SocketUtils_unittest.cpp",
        "test/android/base/sockets/SocketWaiter_unittest.cpp",
        "test/android/utils/eintr_wrapper_unittest.cpp",
