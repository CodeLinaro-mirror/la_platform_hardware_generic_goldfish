load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "cpu",
    srcs = [
        "apple_cpu_accelerator.h",
        "cpu_accelerator.cc",
        "src/android/goldfish/cpu/x86_cpuid.h",
        "x86_cpuid.cc",
    ] + select({
        "@platforms//os:windows": [
            "windows_installer.cc",
            "windows_installer.h",
        ],
        "//conditions:default": [],
    }),
    hdrs = [
        "include/android/cpu_accelerator.h",
        "include/android/goldfish/cpu/cpu_accelerator.h",
    ],
    copts =
        select({
            "@platforms//os:windows": ["-Wno-microsoft-goto"],
            "//conditions:default": [],
        }),
    includes = [
        "include",
        "src",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//android/system",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/strings:str_format",
        "@aemu//base:aemu-base",
    ],
)

cc_test(
    name = "cpu_unittests",
    srcs = ["x86_cpuid_test.cc"],
    linkopts = select({
        "@platforms//os:macos": ["-undefined error"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":cpu",
        "//android/system:googletest_main",
        "//android/system:test-headers",
    ],
)
