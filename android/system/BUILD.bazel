        "@abseil-cpp//absl/log:flags",
        "@abseil-cpp//absl/log:initialize",
        "@googletest//:gtest",
    ],
)

cc_binary(
    name = "clock_perf",
    testonly = True,
    srcs = ["bm_clock.cc"],
    copts = [
        "-Wno-deprecated-declarations",
        "-Wno-unused-result",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":clock",
        ":system",
        "@google_benchmark//:benchmark",
    ],
)
