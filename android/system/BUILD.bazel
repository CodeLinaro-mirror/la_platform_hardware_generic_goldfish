load("@goldfish_build//rules:clang_tidy.bzl", "clang_tidy_test")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test", "objc_library")

cc_library(
    name = "clock",
    srcs = [
        "abseil_clock.cc",
        "clock.cc",
    ],
    hdrs = [
        "include/android/base/abseil_clock.h",
        "include/android/base/clock.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/time",
    ],
)

cc_library(
    name = "eintr_wrapper",
    hdrs = ["include/android/base/eintr_wrapper.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = ["@abseil-cpp//absl/log"],
)

cc_library(
    name = "scoped_file_handle",
    hdrs = ["include/android/base/scoped_file_handle.h"],
    includes = ["include"],
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//visibility:public"],
    deps = ["//emulator/libs/base"],
)

cc_library(
    name = "scoped_reg_key",
    hdrs = ["include/android/base/scoped_reg_key.h"],
    includes = ["include"],
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//visibility:public"],
    deps = ["//emulator/libs/base"],
)

cc_library(
    name = "file",
    srcs = [
        "file.cc",
        "storage_capacity.cc",
    ],
    hdrs = [
        "include/android/base/file/file.h",
        "include/android/base/storage_capacity.h",
    ],
    includes = ["include"],
    tags = ["no-tidy"],
    visibility = ["//visibility:public"],
    deps = [
        ":eintr_wrapper",
        "//android/status_macros",
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/status:statusor",
    ],
)

objc_library(
    name = "system-darwin",
    srcs = ["system-native-mac.mm"],
    copts = ["-std=c++20"],
    sdk_frameworks = [
        "IOKit",
        "AppKit",
    ],
    target_compatible_with = [
        "@platforms//os:macos",
    ],
    alwayslink = True,
)

cc_library(
    name = "system",
    srcs = [
        "bazel_info.cc",
        "system.cc",
    ],
    hdrs = [
        "include/android/base/bazel_info.h",
        "include/android/base/c_str_wrapper.h",
        "include/android/base/cpu_time.h",
        "include/android/base/memory.h",
        "include/android/base/no_sigalarm.h",
        "include/android/base/system.h",
        "include/android/utils/compiler.h",
    ],
    includes = ["include"],
    linkopts = select({
        "@platforms//os:windows": [
            "-DEFAULTLIB:Shell32.lib",
            "-DEFAULTLIB:User32.lib",
        ],
        "//conditions:default": [],
    }),
    tags = ["no-tidy"],
    visibility = ["//visibility:public"],
    deps = [
        ":clock",
        ":eintr_wrapper",
        ":file",
        "//android/process",
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/base",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings:str_format",
        "@bazel_tools//tools/cpp/runfiles",
    ] + select({
        "@platforms//os:windows": [
            ":scoped_reg_key",
            ":win32_utils",
            "@aemu//windows:compat",
            "@glib//glib/dirent",
        ],
        "@platforms//os:macos": [
            ":system-darwin",
        ],
        "//conditions:default": [],
    }),
)

cc_library(
