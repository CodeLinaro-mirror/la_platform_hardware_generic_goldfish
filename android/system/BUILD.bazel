load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "clock",
    srcs = [
        "abseil_clock.cc",
        "clock.cc",
    ],
    hdrs = [
        "include/android/base/abseil_clock.h",
        "include/android/base/clock.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/time",
        "@aemu//base:aemu-base",
    ],
)

cc_library(
    name = "file",
    srcs = [
        "file.cc",
        "storage_capacity.cc",
    ],
    hdrs = [
        "include/android/base/file/file.h",
        "include/android/base/storage_capacity.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/status:statusor",
        "@aemu//base:aemu-base",
    ],
)

cc_library(
    name = "system",
    srcs = [
        "bazel_info.cc",
        "system.cc",
        "version.cc",
    ],
    hdrs = [
        "include/android/base/bazel_info.h",
        "include/android/base/c_str_wrapper.h",
        "include/android/base/no_sigalarm.h",
        "include/android/base/system.h",
        "include/android/utils/compiler.h",
    ],
    includes = ["include"],
    linkopts = select({
        "@platforms//os:windows": [
            "-DEFAULTLIB:Shell32.lib",
            "-DEFAULTLIB:User32.lib",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":clock",
        ":file",
        "//android/process",
        "@abseil-cpp//absl/algorithm:container",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/strings:str_format",
        "@aemu//base:aemu-base",
        "@bazel_tools//tools/cpp/runfiles",
    ] + select({
        "@platforms//os:windows": [
            ":win32_utils",
            "@glib//glib/dirent",
        ],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "test-headers",
    testonly = True,
    srcs = ["test_file_util_bazel.cc"],
    hdrs = [
        "test-headers/android/base/system/TestClock.h",
        "test-headers/android/base/testing/TestSystem.h",
        "test-headers/android/base/testing/TestTempDir.h",
        "test-headers/android/base/testing/TestThread.h",
        "test-headers/android/base/testing/needs_winsock.h",
        "test-headers/android/base/testing/test_event.h",
        "test-headers/android/base/testing/test_file_util.h",
    ],
    includes = ["test-headers"],
    visibility = ["//visibility:public"],
    deps = [
        ":system",
        "@abseil-cpp//absl/log:absl_log",
        "@abseil-cpp//absl/strings",
        "@aemu//base:aemu-base",
        "@bazel_tools//tools/cpp/runfiles",
    ],
)

cc_test(
    name = "system-unittests",
    srcs = [
        "bazel_info_test.cc",
        "file_test.cc",
        "storage_capacity_test.cc",
        "system_test.cc",
        "version_test.cc",
    ],
    data = ["test/android/base/bazel/info.txt"],
    visibility = ["//visibility:public"],
    deps = [
        ":system",
        ":test-headers",
        "//android/system:googletest_main",
        "@abseil-cpp//absl/status:status_matchers",
    ],
)

cc_library(
    name = "win32_utils",
    srcs = [
        "win32_unicode_string.cc",
        "win32_utils.cc",
    ],
    hdrs = [
        "include/android/base/win32_unicode_string.h",
        "include/android/base/win32_utils.h",
    ],
    includes = ["include"],
    linkopts = select({
        "@platforms//os:windows": [
            "-DEFAULTLIB:Shell32.lib",
            "-DEFAULTLIB:User32.lib",
        ],
        "//conditions:default": [],
    }),
    target_compatible_with = ["@platforms//os:windows"],
    visibility = ["//visibility:public"],
    deps = ["@abseil-cpp//absl/strings:str_format"],
)

cc_test(
    name = "win32_utils_test",
    srcs = [
        "win32_unicode_string_test.cc",
