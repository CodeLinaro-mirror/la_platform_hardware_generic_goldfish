load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

cc_library(
    name = "sparse",
    srcs = [
        "src/backed_block.c",
        "src/output_file.c",
        "src/sparse.c",
        "src/sparse_crc32.c",
        "src/sparse_err.c",
        "src/sparse_read.c",
    ] + glob([
        "src/*.h",
    ]),
    hdrs = ["include/sparse/sparse.h"],
    includes = ["include"],
    tags = ["no-tidy"],
    visibility = ["//visibility:public"],
    deps = ["@zlib"] + select({
        "@platforms//os:windows": [
            "//third_party/windows/mman",
            "@aemu//base:aemu-base",
            "@aemu//windows:compat",
        ],
        "//conditions:default": [],
    }),
)

cc_binary(
    name = "img2simg",
    srcs = ["src/img2simg.c"],
    tags = ["no-tidy"],
    visibility = ["//visibility:public"],
    deps = [":sparse"] + select({
        "@platforms//os:windows": [
            "//third_party/windows/mman",
        ],
        "//conditions:default": [],
    }),
)
