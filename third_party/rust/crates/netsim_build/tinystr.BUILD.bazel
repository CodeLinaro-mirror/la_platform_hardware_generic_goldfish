"""tinystr bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "tinystr",
    srcs = glob(["**/*.rs"]),
    crate_features = [
        "alloc",
        "zerovec",
    ],
    crate_name = "tinystr",
    crate_root = "src/lib.rs",
    edition = "2021",
    proc_macro_deps = [
        "@displaydoc",
    ],
    deps = [
        "@zerovec",
    ],
)
