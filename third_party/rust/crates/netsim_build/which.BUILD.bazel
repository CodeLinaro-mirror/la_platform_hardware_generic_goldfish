load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "which",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "which",
    edition = "2021",
    deps = [
        "@either",
        "@home",
    ] + select({
        "@bazel_tools//src/conditions:windows": ["@once_cell"],
        "//conditions:default": [
            "@rustix",
        ],
    }),
)
