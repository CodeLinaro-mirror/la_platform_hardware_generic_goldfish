load("@rules_rust//cargo:defs.bzl", "cargo_build_script")
load("@rules_rust//rust:defs.bzl", "rust_library")

cargo_build_script(
    name = "build_script",
    srcs = ["build.rs"],
    data = ["src/languages.json"],
    edition = "2018",
    deps = [
        "@heck",
        "@quote",
        "@serde",
        "@serde_json",
        "@syn",
    ],
)

rust_library(
    name = "gherkin",
    srcs = glob(["src/**/*.rs"]),
    crate_features = [
        "parser",
        "default",
    ],
    crate_name = "gherkin",
    edition = "2018",
    visibility = ["//visibility:public"],
    deps = [
        ":build_script",
        "@peg",
        "@serde",
        "@textwrap",
        "@thiserror",
        "@typed-builder//:typed_builder",
    ],
)
