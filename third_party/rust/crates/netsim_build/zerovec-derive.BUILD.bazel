"""zerovec_derive bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_proc_macro")

package(default_visibility = ["//visibility:public"])

rust_proc_macro(
    name = "zerovec-derive",
    srcs = glob(["**/*.rs"]),
    crate_name = "zerovec_derive",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        "@proc-macro2",
        "@quote",
        "@syn",
    ],
)
