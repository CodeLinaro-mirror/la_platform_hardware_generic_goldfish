load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "env_filter",
    srcs = glob(["**/*.rs"]),
    crate_features = [
        "default",
        "regex",
    ],
    crate_name = "env_filter",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        "@log",
        "@regex",
    ],
)
