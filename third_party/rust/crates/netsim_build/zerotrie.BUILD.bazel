"""zerotrie bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "zerotrie",
    srcs = glob(["**/*.rs"]),
    crate_features = [
        "alloc",
        "litemap",
        "serde",
        "yoke",
        "zerofrom",
        "zerovec",
    ],
    crate_name = "zerotrie",
    crate_root = "src/lib.rs",
    edition = "2021",
    proc_macro_deps = [
        "@displaydoc",
    ],
    deps = [
        "@litemap",
        "@serde_core",
        "@yoke",
        "@zerofrom",
        "@zerovec",
    ],
)
