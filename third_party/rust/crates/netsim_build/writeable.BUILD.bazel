"""writeable bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "writeable",
    srcs = glob(["**/*.rs"]),
    crate_features = [
        "alloc",
        "default",
    ],
    crate_name = "writeable",
    crate_root = "src/lib.rs",
    edition = "2021",
)
