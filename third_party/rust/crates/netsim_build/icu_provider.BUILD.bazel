"""icu_provider bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "icu_provider",
    srcs = glob(["**/*.rs"]),
    crate_features = [
        "alloc",
        "baked",
    ],
    crate_name = "icu_provider",
    crate_root = "src/lib.rs",
    edition = "2021",
    proc_macro_deps = [
        "@displaydoc",
    ],
    deps = [
        "@icu_locale_core",
        "@stable_deref_trait",
        "@writeable",
        "@yoke",
        "@zerofrom",
        "@zerotrie",
        "@zerovec",
    ],
)
