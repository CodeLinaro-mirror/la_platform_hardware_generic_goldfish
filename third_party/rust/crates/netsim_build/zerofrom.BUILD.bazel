"""zerofrom bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "zerofrom",
    srcs = glob(["**/*.rs"]),
    crate_features = [
        "alloc",
        "derive",
    ],
    crate_name = "zerofrom",
    crate_root = "src/lib.rs",
    edition = "2021",
    proc_macro_deps = [
        "@zerofrom-derive",
    ],
)
