"""icu_normalizer bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "icu_normalizer",
    srcs = glob(["**/*.rs"]),
    crate_features = [
        "compiled_data",
    ],
    crate_name = "icu_normalizer",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        "@icu_collections",
        "@icu_normalizer_data",
        "@icu_provider",
        "@smallvec",
        "@zerovec",
    ],
)
