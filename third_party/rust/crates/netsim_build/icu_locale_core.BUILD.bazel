"""icu_locale_core bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "icu_locale_core",
    srcs = glob(["**/*.rs"]),
    crate_features = [
        "alloc",
        "zerovec",
    ],
    crate_name = "icu_locale_core",
    crate_root = "src/lib.rs",
    edition = "2021",
    proc_macro_deps = [
        "@displaydoc",
    ],
    deps = [
        "@litemap",
        "@tinystr",
        "@writeable",
        "@zerovec",
    ],
)
