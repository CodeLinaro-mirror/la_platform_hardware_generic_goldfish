"""log bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "log",
    srcs = glob(["**/*.rs"]),
    crate_name = "log",
    edition = "2021",
    crate_root = "src/lib.rs",
    deps = [
        "@android_log-sys",
        "@once_cell",
    ],
    rustc_flags = [
        "--cfg=feature=\"std\"",
    ],
)

rust_library(
    name = "log_rust_max_level_info",
    srcs = glob(["**/*.rs"]),
    crate_name = "log",
    edition = "2021",
    crate_root = "src/lib.rs",
    deps = [
        "@android_log-sys",
        "@once_cell",
    ],
    rustc_flags = [
        "--cfg=feature=\"max_level_info\"",
        "--cfg=feature=\"release_max_level_info\"",
        "--cfg=feature=\"std\"",
    ],
)

rust_library(
    name = "log_rust_max_level_off",
    srcs = glob(["**/*.rs"]),
    crate_name = "log",
    edition = "2021",
    crate_root = "src/lib.rs",
    deps = [
        "@android_log-sys",
        "@once_cell",
    ],
    rustc_flags = [
        "--cfg=feature=\"max_level_off\"",
        "--cfg=feature=\"release_max_level_off\"",
        "--cfg=feature=\"std\"",
    ],
)
