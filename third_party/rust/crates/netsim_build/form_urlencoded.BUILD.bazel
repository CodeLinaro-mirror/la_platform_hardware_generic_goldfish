"""form_urlencoded bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "form_urlencoded",
    srcs = glob(["**/*.rs"]),
    crate_features = [
        "alloc",
        "default",
        "std",
    ],
    crate_name = "form_urlencoded",
    crate_root = "src/lib.rs",
    edition = "2018",
    deps = [
        "@percent-encoding",
    ],
)
