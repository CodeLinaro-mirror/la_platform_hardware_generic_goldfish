"""stable_deref_trait bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "stable_deref_trait",
    srcs = glob(["**/*.rs"]),
    crate_features = [
        "alloc",
        "std",
    ],
    crate_name = "stable_deref_trait",
    crate_root = "src/lib.rs",
    edition = "2015",
)
