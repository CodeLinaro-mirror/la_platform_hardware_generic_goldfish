"""potential_utf bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "potential_utf",
    srcs = glob(["**/*.rs"]),
    crate_features = [
        "alloc",
        "serde",
        "writeable",
        "zerovec",
    ],
    crate_name = "potential_utf",
    crate_root = "src/lib.rs",
    edition = "2021",
    deps = [
        "@serde_core",
        "@writeable",
        "@zerovec",
    ],
)
