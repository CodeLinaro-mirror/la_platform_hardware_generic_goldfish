"""serde bazel build rule"""

load("@rules_rust//rust:defs.bzl", "rust_library")

package(default_visibility = ["//visibility:public"])

rust_library(
    name = "serde",
    srcs = glob(["**/*.rs"]),
    data = ["out/private.rs"],
    crate_name = "serde",
    edition = "2021",
    crate_root = "src/lib.rs",
    rustc_env = {"OUT_DIR": "../out"},
    deps = ["@serde_core"],
    proc_macro_deps = ["@serde_derive"],
    rustc_flags = [
        "--cfg=feature=\"default\"",
        "--cfg=feature=\"derive\"",
        "--cfg=feature=\"rc\"",
        "--cfg=feature=\"serde_derive\"",
        "--cfg=feature=\"std\"",
    ],
)
