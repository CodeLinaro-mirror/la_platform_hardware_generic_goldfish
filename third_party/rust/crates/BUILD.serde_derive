# Using wrapped version of rust_proc_macro is required when running x64 rustc on mac-arm64 thru Rosetta
# Otherwise, replace with "load("@rules_rust//rust:defs.bzl", "rust_proc_macro")"
load("@//build/bazel/rules:rust_proc_macro.bzl", "rust_proc_macro")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    package_name = "serde_derive",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

rust_proc_macro(
    name = "serde_derive",
    srcs = glob(
        include = ["**/*.rs"],
        exclude = [
        ],
    ),
    features = ["default"],
    edition = "2015",
    rustc_flags = [
        "--cap-lints=allow",
    ],
    visibility = [
        "//visibility:public",
    ],
    deps = [
        "@proc-macro2",
        "@quote",
        "@syn",
    ],
)
