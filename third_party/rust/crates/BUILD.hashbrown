load("@rules_license//rules:license.bzl", "license")
load("@rules_rust//rust:defs.bzl", "rust_library")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    package_name = "hashbrown",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
)

exports_files([
    "BUILD",
    "LICENSE",
    "METADATA",
])

rust_library(
    name = "hashbrown",
    srcs = glob(["src/**/*.rs"]),
    compile_data = [
        "README.md",
    ],
    crate_features = [
        "default",
        "default-hasher",
        "equivalent",
        "raw-entry",
        "default",
        "default-hasher",
        "equivalent",
        "inline-more",
        "raw",
        "raw-entry",
        "serde",
    ],
    edition = "2021",
    rustc_flags = [
        "--cap-lints=allow",
    ],
    deps = [
        "@equivalent",
        "@foldhash",
        "@serde",
    ],
)
